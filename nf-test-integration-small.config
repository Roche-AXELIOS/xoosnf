/*
 * nf-test config for the integration-small pipeline test.
 *
 * The default nf-test.config ignores tests/integration_small.nf.test so it
 * never runs in the sharded stub CI job (stub tests are self-contained and need
 * no data). This config does NOT ignore it, so the dedicated integration-small
 * CI action can run it by explicit path:
 *
 *   nf-test test tests/integration_small.nf.test -c nf-test-integration-small.config
 *
 * The integration-small test requires a checked-out subsampled dataset,
 * provided via the TEST_DATA_DIR env var (CI checks it out with actions/checkout).
 */
config {
    testsDir "."
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    libDir "tests/lib"
    profile "test"

    plugins {
        load "nft-utils@0.0.3"
    }
}
