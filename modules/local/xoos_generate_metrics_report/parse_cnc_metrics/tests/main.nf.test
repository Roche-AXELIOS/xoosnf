nextflow_process {

    name "Test Process XOOS_PARSE_CNC_METRICS"
    script "../main.nf"
    process "XOOS_PARSE_CNC_METRICS"

    tag "modules"
    tag "modules_local"
    tag "xoos_parse_cnc_metrics"

    test("real script: finds prefixed metrics TSV nested under a staged metrics directory") {

        setup {
            def base = "${launchDir}/test-data/nested"
            new File("${base}/metrics").mkdirs()
            new File("${base}/metrics/HG001_metrics.tsv").text = "Metric\tValue\nNumber of segments\t1\n"
        }

        when {
            process {
                """
                def base = "${launchDir}/test-data/nested"
                input[0] = [
                    [id: 'HG001'],
                    [ file("\${base}/metrics") ]
                ]
                """
            }
        }

        then {
            if (process.success) {
                assert process.out.report
            } else {
                assert process.errorReport.contains('Command exit status:\n  127')
                assert process.errorReport.contains('generate-metrics-report: command not found')
            }
        }
    }

    test("real script: fails fast if no CNC metrics TSV is staged") {

        setup {
            def base = "${launchDir}/test-data/missing"
            new File("${base}").mkdirs()
            new File("${base}/callset.seg").text = ""
        }

        when {
            process {
                """
                def base = "${launchDir}/test-data/missing"
                input[0] = [
                    [id: 'HG001'],
                    [ file("\${base}/callset.seg") ]
                ]
                """
            }
        }

        then {
            assert !process.success
            assert process.errorReport.contains('Command exit status:\n  1\n')
        }
    }
}
