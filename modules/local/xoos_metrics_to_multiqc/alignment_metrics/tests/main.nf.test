nextflow_process {

    name "Test Process XOOS_ALIGNMENT_METRICS_TO_MULTIQC"
    script "../main.nf"
    process "XOOS_ALIGNMENT_METRICS_TO_MULTIQC"

    tag "modules"
    tag "modules_local"
    tag "xoos_metrics_to_multiqc"
    tag "xoos_metrics_to_multiqc/alignment_metrics"

    test("stub - generates alignment metrics multiqc input") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of(
                    [ [id: 'SAMPLE1'], file('read_metrics'), file('coverage_metrics'), file('accuracy_metrics') ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.multiqc_report_dir,
                    process.out.versions.collect { it[0..-2] }
                ).match() },
                { assert process.out.multiqc_report_dir.size() == 1 },
                { assert process.out.multiqc_report_dir[0][1].toString().endsWith('_alignment_metrics_multiqc_input') },
            )
        }
    }

    test("stub - preserves meta in output") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of(
                    [ [id: 'SAMPLE2', run_type: 'sbx-d'], file('read_metrics'), file('coverage_metrics'), file('accuracy_metrics') ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.multiqc_report_dir,
                    process.out.versions.collect { it[0..-2] }
                ).match() },
                { assert process.out.multiqc_report_dir[0][0].id == 'SAMPLE2' },
                { assert process.out.multiqc_report_dir[0][0].run_type == 'sbx-d' },
            )
        }
    }

    test("stub - output dir reflects region and stage") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of(
                    [ [id: 'SAMPLE3', metrics_region: 'high_confidence', report_prefix: 'dedup'], file('read_metrics'), file('coverage_metrics'), file('accuracy_metrics') ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.multiqc_report_dir.size() == 1 },
                // Output dir name encodes id_stage_region so per-region outputs
                // do not collide before they are combined.
                { assert process.out.multiqc_report_dir[0][1].toString().endsWith('SAMPLE3_dedup_high_confidence_alignment_metrics_multiqc_input') },
            )
        }
    }
}
