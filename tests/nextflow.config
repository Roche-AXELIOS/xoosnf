/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
    Test-specific overrides for nf-test runs. Resource paths and test data URLs
    are defined in conf/test.config (loaded via -profile test).
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
}

process {
    // Stub tests only create GATK interval/VCF placeholders. Use the GATK image
    // already used by HaplotypeCaller instead of pulling the large Wave image
    // from its intermittently failing registry. Real/integration runs retain
    // the module's production containers.
    withName: '.*GATK4_(SPLITINTERVALS|MERGEVCFS)' {
        container = { workflow.stubRun ? 'docker.io/broadinstitute/gatk-nightly:2026-02-05-4.6.2.0-21-ge8c49f600-NIGHTLY-SNAPSHOT' : (workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/ce/ced519873646379e287bc28738bdf88e975edd39a92e7bc6a34bccd37153d9d0/data' : 'community.wave.seqera.io/library/gatk4_gcnvkernel:edb12e4f0bf02cd3') }
    }

    // The generate-metrics-report image is published from dev and is therefore
    // one revision behind during pull-request tests. Run the checked-out script
    // for SVC parsing so integration tests exercise this branch's implementation.
    withName: 'XOOS_PARSE_SVC_METRICS' {
        container = null
        beforeScript = "ln -sf ${projectDir}/modules/local/xoos_generate_metrics_report/generate-metrics-report.py generate-metrics-report && export PATH=\$PWD:\$PATH"
    }
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
