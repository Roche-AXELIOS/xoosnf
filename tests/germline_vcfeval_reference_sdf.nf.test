nextflow_pipeline {

    name "Test pipeline - germline vcfeval with pre-built reference SDF (stub)"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_stub"
    tag "germline"
    tag "vcfeval"
    tag "reference_sdf"

    test("stub - germline bwa with vcfeval using reference_sdf") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data")
                .bwaRef()
                .variantCallingResources()
                .vcfevalResources()
                .referenceSdf()
                .fastqs()
                .samplesheets()
                .writeResources()
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir                                  = "$outputDir"
                input                                   = "${launchDir}/test-data/inputs/input_samplesheet.csv"
                aligner                                 = 'bwa'
                variant_calling_mode                    = 'germline'
                enable_small_variant_caller             = true
                enable_vcfeval                          = true
                dedup_strategy                          = 'markdup'
            }
        }

        then {
            def stableOutputFiles = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableVersions = path("$outputDir/pipeline_info/xoos_software_mqc_versions.yml").yaml
                .findAll { k, v -> k != "Nextflow" && k != "Workflow" }
                .collectEntries { process, tools ->
                    [process, tools instanceof Map ? tools.keySet().findAll { it != "Nextflow" }.sort() : []]
                }
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stableVersions,
                    stableOutputFiles
                ).match() }
            )
        }
    }

    test("stub - germline bwa with vcfeval without reference_sdf") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data")
                .bwaRef()
                .variantCallingResources()
                .vcfevalResources()
                .fastqs()
                .samplesheets()
                .writeResources()
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir                                  = "$outputDir"
                input                                   = "${launchDir}/test-data/inputs/input_samplesheet.csv"
                aligner                                 = 'bwa'
                variant_calling_mode                    = 'germline'
                enable_small_variant_caller             = true
                enable_vcfeval                          = true
                dedup_strategy                          = 'markdup'
            }
        }

        then {
            def stableOutputFiles = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableVersions = path("$outputDir/pipeline_info/xoos_software_mqc_versions.yml").yaml
                .findAll { k, v -> k != "Nextflow" && k != "Workflow" }
                .collectEntries { process, tools ->
                    [process, tools instanceof Map ? tools.keySet().findAll { it != "Nextflow" }.sort() : []]
                }
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stableVersions,
                    stableOutputFiles
                ).match() }
            )
        }
    }
}
