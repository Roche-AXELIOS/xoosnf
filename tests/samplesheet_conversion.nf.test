            new File("${fastqDir}/HG001_001.fastq.gz").text = ''

            new File("${inputsDir}/samplesheet.csv").text = """\
[Samples]
Sample ID, Some Other Column
HG001, foo
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,demultiplexed_fastq,${fastqDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/missing_column/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains("missing a 'Sample Index' column") }
            )
        }
    }
}
