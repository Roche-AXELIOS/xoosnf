    test("stub - sectioned samplesheet produces correct canonical output") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/sectioned_content_check"
            def fastqDir = "${testDir}/fastq_dir"
            def inputsDir = "${testDir}/inputs"
            new File(fastqDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${fastqDir}/HG001_001.fastq.gz").text = ''
            new File("${fastqDir}/HG002_001.fastq.gz").text = ''

            new File("${inputsDir}/samplesheet.csv").text = """\
# Comment line
[Header]
Experiment, Test

[Samples]
Sample ID, Sample Index, Sample Type
HG001,CTATTGAAGGCT,auto-detect
HG002,GGAGTAACATCC,ffpe
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,demultiplexed_fastq,${fastqDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/sectioned_content_check/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
                enable_copy_number_caller   = false
                enable_str_caller           = false
            }
        }

        then {
            // Locate the converted file by its deterministic hash (md5 of original content).
            def originalContent = new File("${outputDir}/sectioned_content_check/inputs/samplesheet.csv").text
            def hash = originalContent.md5()
            def convertedFile = new File(System.getProperty('java.io.tmpdir'), "xoos-converted-samplesheets/${hash}.csv")
            assertAll(
                { assert workflow.success },
                { assert convertedFile.exists() : "Converted file not found at expected path: ${convertedFile}" },
                { assert convertedFile.readLines()[0] == 'sample_name,sample_sid,sample_type' : "Header mismatch: ${convertedFile.readLines()[0]}" },
                { assert convertedFile.text.contains('HG001') },
                { assert convertedFile.text.contains('HG002') },
                { assert convertedFile.text.contains('auto-detect') },
                { assert convertedFile.text.contains('ffpe') }
            )
        }
    }

    test("should fail - sectioned samplesheet without [Samples] section") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/no_samples_section"
            def fastqDir = "${testDir}/fastq_dir"
            def inputsDir = "${testDir}/inputs"
            new File(fastqDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${fastqDir}/HG001_001.fastq.gz").text = ''

            new File("${inputsDir}/samplesheet.csv").text = """\
[Header]
Experiment Name, Test Experiment

[Settings]
Adapter, AGATCGGAAGAGC
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,demultiplexed_fastq,${fastqDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/no_samples_section/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains('no [Samples] section') }
            )
        }
    }

