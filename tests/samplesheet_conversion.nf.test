nextflow_pipeline {

    name "Test pipeline - sectioned samplesheet conversion"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_stub"
    tag "samplesheet_conversion"

    test("stub - sectioned samplesheet with [Samples] header") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/sectioned_basic"
            def fastqDir = "${testDir}/fastq_dir"
            def inputsDir = "${testDir}/inputs"
            new File(fastqDir).mkdirs()
            new File(inputsDir).mkdirs()

            // Create FASTQ placeholders
            new File("${fastqDir}/HG001_001.fastq.gz").text = ''
            new File("${fastqDir}/HG002_001.fastq.gz").text = ''

            // Create a sectioned samplesheet
            new File("${inputsDir}/samplesheet.csv").text = """\
[Samples]
Sample ID, Sample Index, Sample Type
HG001,CTATTGAAGGCT,auto-detect
HG002,GGAGTAACATCC,ffpe
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,demultiplexed_fastq,${fastqDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/sectioned_basic/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
                enable_copy_number_caller   = false
                enable_str_caller           = false
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

