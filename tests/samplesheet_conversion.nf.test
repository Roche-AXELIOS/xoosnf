                input  = "${outputDir}/sectioned_extras/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
                enable_copy_number_caller   = false
                enable_str_caller           = false
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

