// Mirror the SAMTOOLS_REHEADER configuration from workflows/nextflow.config so
// this process-level test exercises the exact header-rewrite command used by
// the enable_bam_reheader pipeline option.
process {
    withName: 'SAMTOOLS_REHEADER' {
        ext.prefix = { "${meta.id}_reheadered" }
        ext.args = { "-c 'sed \"/^@RG/{s/\tID:[^\t]*/\tID:${meta.id}/;s/\tSM:[^\t]*/\tSM:${meta.id}/}\"'" }
    }
}
