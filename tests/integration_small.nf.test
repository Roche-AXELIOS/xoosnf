            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stableVersions,
                    stableOutputFiles
                ).match() }
            )
        }
    }

    test("integration small - germline giraffe demultiplexed_fastq") {
        when {
            params {
                def testDataDir = System.getenv('TEST_DATA_DIR') ?: "${projectDir}/test-data"
                load("${testDataDir}/resources/resources.json")
                outdir                      = "$outputDir"
                input                       = "${testDataDir}/demultiplexed_fastq/runsheet.csv"
                aligner                     = 'vg_giraffe'
                // Use the subset linearized reference: no sibling .ref_paths_dict exists
                // for it in the test dataset, so the soft-check in the pipeline skips
                // --ref-paths for vg giraffe (the test GBZ path names don't match the
                // chr-prefixed names in the standard .ref_paths_dict).
                giraffe_reference_linearized = "${testDataDir}/resources/hprc-v1.1-mc-grch38.d9.masked.remove_prefix.v70/hprc-v1.1-mc-grch38.d9.masked.remove_prefix.v70.subset.fa"
                dedup_strategy              = 'markdup'
                variant_calling_mode        = 'germline'
                use_gatk_haplotype_caller   = true
                enable_small_variant_caller = true
                enable_copy_number_caller   = false
                enable_str_caller           = false
            }
        }

        then {
            def stableOutputFiles = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableVersions = path("$outputDir/pipeline_info/xoos_software_mqc_versions.yml").yaml
                .findAll { k, v -> k != "Nextflow" && k != "Workflow" }
                .collectEntries { process, tools ->
                    [process, tools instanceof Map ? tools.keySet().findAll { it != "Nextflow" }.sort() : []]
                }
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stableVersions,
                    stableOutputFiles
                ).match() }
            )
        }
    }

