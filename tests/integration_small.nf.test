    test("integration empty basecall FASTQ exits gracefully") {
        setup {
            // Keep the run sheet and run directory valid so schema validation
            // accepts the input. Only the FASTQ payload is empty; a missing run
            // directory is a separate schema-validation failure and is not the
            // behavior under test here.
            TestFixture.under("${launchDir}/test-data")
                .emptyBasecallFastq()
        }

        when {
            params {
                def testDataDir = System.getenv('TEST_DATA_DIR') ?: "${projectDir}/test-data"
                load("${testDataDir}/resources/resources.json")
                outdir                              = "$outputDir"
                input                               = "${launchDir}/test-data/inputs/empty_basecall_fastq/runsheet.csv"
                // Keep the run directory and samplesheet valid; this test isolates
                // graceful handling of a valid zero-record FASTQ. In particular,
                // do not enable subsample_run, which would reject an empty run
                // directory before demultiplexing.
                enable_subsample_run                = false
                aligner                             = 'bwa'
                dedup_strategy                      = 'markdup'
                enable_demux_early_stop             = true
                demux_early_stop_coverage_target    = 1
                enable_publish_demuxed_fastqs       = true
                enable_pangenome_personalization    = false
                variant_calling_mode                 = 'germline'
                use_gatk_haplotype_caller            = true
                enable_small_variant_caller          = true
                enable_copy_number_caller           = true
                enable_str_caller                   = true
                enable_merge_vcf                    = true
                enable_alignment_metrics_autosomes  = true
                enable_alignment_metrics_high_confidence = true
                enable_contamination_estimation    = false
                enable_variant_calling_partitioning = false
            }
        }

        then {
            def sampleDir = new File(params.outdir, 'empty_fastq_run/empty_sample')
            def demuxFastqDir = new File(sampleDir, 'fastqs')
            def demuxFastqs = []
            if (demuxFastqDir.isDirectory()) {
                demuxFastqDir.eachFileRecurse { file ->
                    if (file.name.endsWith('.fastq.gz')) {
                        demuxFastqs << file
                    }
                }
            }

            def outputFastqsAreEmpty = !demuxFastqs.isEmpty() && demuxFastqs.every { fastq ->
                new java.util.zip.GZIPInputStream(new FileInputStream(fastq)).withCloseable { input ->
                    input.read() == -1
                }
            }

            def bamFile = new File(sampleDir, 'empty_sample_markdup.bam')
            def bamIsValidAndEmpty = {
                def reader = htsjdk.samtools.SamReaderFactory.makeDefault().open(bamFile)
                try {
                    reader.fileHeader != null && reader.hasIndex() && !reader.iterator().hasNext()
                } finally {
                    reader.close()
                }
            }

            def vcfFile = new File(sampleDir, 'empty_sample.vcf.gz')
            def vcfIsValidAndIndexed = {
                def reader = new htsjdk.variant.vcf.VCFFileReader(vcfFile, true)
                def iterator = reader.iterator()
                try {
                    iterator.hasNext()
                    reader.fileHeader != null
                } finally {
                    iterator.close()
                    reader.close()
                }
            }

            def metricsSummaryFile = new File(params.outdir, 'empty_fastq_run/metrics-report-summary.tsv')

            assertAll(
                { assert workflow.success },
                { assert new File(params.outdir, 'pipeline_info').isDirectory() },
                { assert !demuxFastqs.isEmpty() },
                { assert outputFastqsAreEmpty },
                { assert bamFile.isFile() },
                { assert new File(sampleDir, 'empty_sample_markdup.bam.bai').isFile() },
                { assert bamIsValidAndEmpty() },
                { assert vcfFile.isFile() },
                { assert new File(sampleDir, 'empty_sample.vcf.gz.tbi').isFile() },
                { assert vcfIsValidAndIndexed() },
                { assert metricsSummaryFile.isFile() && metricsSummaryFile.readLines().any { it.trim() } },
            )
        }
    }
}
