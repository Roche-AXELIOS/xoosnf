        when {
            params {
                def testDataDir = System.getenv('TEST_DATA_DIR') ?: "${projectDir}/test-data"
                load("${testDataDir}/resources/resources.json")
                outdir                      = "$outputDir"
                input                       = "${testDataDir}/demultiplexed_fastq/runsheet.csv"
                aligner                     = 'bwa'
                dedup_strategy              = 'markdup'
                variant_calling_mode        = 'germline'
                use_gatk_haplotype_caller   = true
                enable_small_variant_caller = true
                enable_copy_number_caller   = false
                enable_str_caller           = false
            }
        }

        then {
            def stableOutputFiles = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableVersions = path("$outputDir/pipeline_info/xoos_software_mqc_versions.yml").yaml
                .findAll { k, v -> k != "Nextflow" && k != "Workflow" }
                .collectEntries { process, tools ->
                    [process, tools instanceof Map ? tools.keySet().findAll { it != "Nextflow" }.sort() : []]
