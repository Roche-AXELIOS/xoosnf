nextflow_pipeline {

    name "Test pipeline - BAM input, skip demux and alignment (stub)"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_stub"
    tag "bam_input"

    test("stub - bam input with germline variant calling") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data")
                .bwaRef()
                .variantCallingResources()
                .bams()
                .samplesheets()
                .writeResources()
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir                      = "$outputDir"
                input                       = "${launchDir}/test-data/inputs/input_samplesheet_bam.csv"
                aligner                     = 'bwa'
                variant_calling_mode        = 'germline'
                enable_small_variant_caller = true
                use_gatk_haplotype_caller   = true
                dedup_strategy              = 'markdup'
            }
        }

        then {
            def stableOutputFiles = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableVersions = path("$outputDir/pipeline_info/xoos_software_mqc_versions.yml").yaml
                .findAll { k, v -> k != "Nextflow" && k != "Workflow" }
                .collectEntries { process, tools ->
                    [process, tools instanceof Map ? tools.keySet().findAll { it != "Nextflow" }.sort() : []]
                }
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stableVersions,
                    stableOutputFiles
                ).match() }
            )
        }
    }

    test("stub - incompatible externally deduplicated BAM fails validation") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data")
                .bwaRef()
                .bams()
                .xoosMarkdupBamSamplesheet()
                .writeResources()
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir                              = "$outputDir"
                input                               = "${launchDir}/test-data/inputs/input_samplesheet_xoos_markdup.csv"
                aligner                             = 'bwa'
                dedup_strategy                      = 'none'
                variant_calling_mode                = 'none'
                enable_small_variant_caller         = false
                enable_copy_number_caller           = false
                enable_str_caller                   = false
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains("bam_type 'xoos_markdup'") },
                { assert combined.contains("requires pipeline dedup_strategy='markdup'") }
            )
        }
    }
}
