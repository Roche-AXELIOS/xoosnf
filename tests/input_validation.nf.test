                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('does not exist') || it.contains('No such file') } ||
                         workflow.stderr.any { it.contains('does not exist') || it.contains('No such file') } }
            )
        }
    }

    test("should fail - enable_subsample_bam without target_coverage") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/subsample_no_coverage"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${bamDir}/HG001.bam").text = ''
            new File("${bamDir}/HG001.bam.bai").text = ''

            // Samplesheet without target_coverage column
            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/subsample_no_coverage/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
                enable_subsample_bam = true
                subsample_bam_coverage_target = null
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains('has no target_coverage in the samplesheet') },
                { assert combined.contains('HG001') }
            )
        }
    }

    test("should pass - enable_subsample_bam with global fallback") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/subsample_global_fallback"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${bamDir}/HG001.bam").text = ''
            new File("${bamDir}/HG001.bam.bai").text = ''

            // Samplesheet without target_coverage — but global fallback is set
            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/subsample_global_fallback/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
                enable_subsample_bam = true
                subsample_bam_coverage_target = 30
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("should fail - somatic_tn without TN and group columns") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/somatic_no_tn"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${bamDir}/HG001.bam").text = ''
            new File("${bamDir}/HG001.bam.bai").text = ''
            new File("${bamDir}/HG002.bam").text = ''
            new File("${bamDir}/HG002.bam.bai").text = ''

            // Samplesheet without TN/group columns
            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
HG002,GGAGTAACATCC
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/somatic_no_tn/inputs/input.csv"
                aligner = 'bwa'
                variant_calling_mode = 'somatic_tn'
                enable_small_variant_caller = false
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains("variant_calling_mode is 'somatic_tn'") },
                { assert combined.contains('TN') && combined.contains('group') }
            )
        }
    }

