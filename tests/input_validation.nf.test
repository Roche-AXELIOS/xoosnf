    test("should fail - enable_hs_metrics without capture_bed and target_bed") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/hs_metrics_no_bed"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${bamDir}/HG001.bam").text = ''
            new File("${bamDir}/HG001.bam.bai").text = ''

            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/hs_metrics_no_bed/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
                // reference_fasta comes from the test profile; capture_bed and
                // target_bed are intentionally absent so the only unmet
                // enable_hs_metrics requirement is the BED files.
                enable_hs_metrics = true
                capture_bed = null
                target_bed = null
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains('enable_hs_metrics requires reference_fasta, capture_bed, and target_bed') }
            )
        }
    }

    test("should fail - giraffe aligner with somatic_tn mode") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().giraffeRef().writeResources()

            def testDir = "${outputDir}/giraffe_somatic_tn"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            new File("${bamDir}/HG001.bam").text = ''
            new File("${bamDir}/HG001.bam.bai").text = ''
            new File("${bamDir}/HG002.bam").text = ''
            new File("${bamDir}/HG002.bam.bai").text = ''

            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid,TN,group
HG001,CTATTGAAGGCT,T,pair1
HG002,GGAGTAACATCC,N,pair1
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/giraffe_somatic_tn/inputs/input.csv"
                aligner = 'pb_giraffe'
                variant_calling_mode = 'somatic_tn'
                enable_small_variant_caller = false
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains("Giraffe aligners (pb_giraffe, vg_giraffe) are not currently supported with variant_calling_mode 'somatic_tn'") }
            )
        }
    }

    test("should fail - enable_merge_vcf with somatic_tn mode") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/merge_vcf_somatic_tn"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
