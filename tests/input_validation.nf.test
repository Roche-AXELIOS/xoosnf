nextflow_pipeline {

    name "Test pipeline - input validation"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_stub"
    tag "input_validation"

    test("should fail - broken BAM symlink") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/broken_bam"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            // Create a broken symlink: points to a nonexistent target
            def link = java.nio.file.Paths.get("${bamDir}/HG001.bam")
            def target = java.nio.file.Paths.get("${bamDir}/nonexistent.bam")
            java.nio.file.Files.createSymbolicLink(link, target)

            // Create a valid samplesheet
            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
"""

            // Create the input samplesheet pointing to the broken BAM dir
            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/broken_bam/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('No such file') } ||
                         workflow.stderr.any { it.contains('No such file') } }
            )
        }
    }

    test("should fail - broken FASTQ symlink") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/broken_fastq"
            def fastqDir = "${testDir}/fastq_dir"
            def inputsDir = "${testDir}/inputs"
            new File(fastqDir).mkdirs()
            new File(inputsDir).mkdirs()

            // Create a broken symlink to a FASTQ file
            def link = java.nio.file.Paths.get("${fastqDir}/raw_fastq_HG001.fastq.gz")
            def target = java.nio.file.Paths.get("${fastqDir}/nonexistent.fastq.gz")
            java.nio.file.Files.createSymbolicLink(link, target)

            // Create a valid samplesheet
            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
"""

            // Create the input samplesheet pointing to the broken FASTQ dir
            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,demultiplexed_fastq,${fastqDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/broken_fastq/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('No such file') } ||
                         workflow.stderr.any { it.contains('No such file') } }
            )
        }
    }

    test("should fail - missing run_dir") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

