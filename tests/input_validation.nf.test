        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('does not exist') || it.contains('No such file') } ||
                         workflow.stderr.any { it.contains('does not exist') || it.contains('No such file') } }
            )
        }
    }

    test("should fail - duplicate BAM names for same sample") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

            def testDir = "${outputDir}/duplicate_bam"
            def bamDir = "${testDir}/bam_dir"
            def inputsDir = "${testDir}/inputs"
            new File(bamDir).mkdirs()
            new File(inputsDir).mkdirs()

            // Two samples each with both a full and a subsampled BAM —
            // both should be reported in a single error.
            ['HG001', 'HG002'].each { sample ->
                ['', '.subsampled'].each { suffix ->
                    new File("${bamDir}/${sample}${suffix}.bam").text = ''
                    new File("${bamDir}/${sample}${suffix}.bam.bai").text = ''
                }
            }

            new File("${inputsDir}/samplesheet.csv").text = """\
sample_name,sample_sid
HG001,CTATTGAAGGCT
HG002,AAAATTTTCCCC
"""

            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/samplesheet.csv
"""
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir = "$outputDir/results"
                input  = "${outputDir}/duplicate_bam/inputs/input.csv"
                aligner = 'bwa'
                enable_small_variant_caller = false
            }
        }

        then {
            // Error spans multiple lines (one per offending sample joined by \n),
            // so flatten stdout+stderr before checking for substrings.
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert combined.contains('multiple matching BAM files') },
                { assert combined.contains('HG001') && combined.contains('HG002') }
            )
        }
    }

    test("should fail - missing samplesheet") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data").bwaRef().writeResources()

