            new File("${bamDir}/HG001.bam").text = ""
            new File("${bamDir}/HG001.bam.bai").text = ""

            // Point to a samplesheet that does not exist
            new File("${inputsDir}/input.csv").text = """\
run_name,run_type,file_type,run_dir,samplesheet
test_run,SBX-D,bam,${bamDir},${inputsDir}/nonexistent_samplesheet.csv
"""
