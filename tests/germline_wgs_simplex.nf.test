nextflow_pipeline {

    name "Test pipeline - WGS simplex with minimap2 (stub)"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_stub"
    tag "wgs_simplex"
    tag "minimap2"

    test("stub - wgs simplex with minimap2 markdup") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data")
                .bwaRef()
                .fastqs()
                .samplesheets()
                .writeResources()
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir                          = "$outputDir"
                input                           = "${launchDir}/test-data/inputs/input_samplesheet.csv"
                aligner                         = 'minimap2'
                variant_calling_mode            = 'none'
                dedup_strategy                  = 'markdup'
                read_collapser_preset           = 'wgs-simplex'
                read_collapser_cluster_by_umi   = true
                enable_small_variant_caller     = false
                enable_copy_number_caller       = false
                enable_str_caller               = false
                enable_alignment_metrics_autosomes = true
                // Both simplex profiles (germline_wgs_simplex, germline_wgs_simplex_benchmark)
                // default enable_contamination_estimation to true; exercise that behavior
                // directly rather than reading the profile default back out of the config text.
                enable_contamination_estimation = true
            }
        }

        then {
            def stableOutputFiles = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableVersions = path("$outputDir/pipeline_info/xoos_software_mqc_versions.yml").yaml
                .findAll { k, v -> k != "Nextflow" && k != "Workflow" }
                .collectEntries { process, tools ->
                    [process, tools instanceof Map ? tools.keySet().findAll { it != "Nextflow" }.sort() : []]
                }
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/test_run/HG001/contamination_detection/contamination_estimation_results.tsv").exists() },
                { assert path("$outputDir/test_run/HG001/contamination_detection/metrics/per_site_counts.tsv").exists() },
                { assert path("$outputDir/test_run/HG002/contamination_detection/contamination_estimation_results.tsv").exists() },
                { assert path("$outputDir/test_run/HG002/contamination_detection/metrics/per_site_counts.tsv").exists() },
                { assert snapshot(
                    stableVersions,
                    stableOutputFiles
                ).match() }
            )
        }
    }

    test("stub - WGS simplex accepts 40x BAM subsampling") {
        options "-stub"

        setup {
            TestFixture.under("${launchDir}/test-data")
                .bwaRef()
                .fastqs()
                .samplesheets()
                .writeResources()
        }

        when {
            params {
                load("${launchDir}/test-data/resources.json")
                outdir                               = "$outputDir"
                input                                = "${launchDir}/test-data/inputs/input_samplesheet.csv"
                aligner                              = 'minimap2'
                variant_calling_mode                 = 'none'
                enable_pangenome_personalization     = false
                enable_small_variant_caller          = false
                enable_small_variant_caller_retrain  = false
                enable_copy_number_caller            = false
                enable_vcfeval                       = false
                enable_alignment_metrics_high_confidence = false
                enable_hp_metrics                    = false
                enable_gc_bias_metrics                = false
                enable_subsample_bam                 = true
                subsample_bam_coverage_target        = 40
            }
        }

        then {
            def simplexConfig = new File("${projectDir}/conf/simplex.config").text
            assertAll(
                { assert workflow.success },
                { assert simplexConfig =~ /(?s)germline_wgs_simplex_benchmark\s*\{.*?subsample_bam_coverage_target\s*=\s*40\b/ },
                { assert params.enable_subsample_bam.toBoolean() },
                { assert (params.subsample_bam_coverage_target as Integer) == 40 },
            )
        }
    }

}
