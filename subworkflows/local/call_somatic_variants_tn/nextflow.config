process {
    withName: '.*:EVALUATE_SOMATIC_SMALL_VARIANTS_TN.*:RTGTOOLS_VCFEVAL' {
        ext.args = {
            return "--threads=${task.cpus} --decompose --ref-overlap --squash-ploidy -f FORMAT.PRED_ML --sample='${meta.id}'"
        }
    }
    withName: GATK4_MERGEMUTECTSTATS {
        ext.args = {
            def avail_mem = 3072
            if (task.memory) { avail_mem = (task.memory.mega * 0.8).intValue() }
            "--java-options \"-Xmx${avail_mem}M -XX:-UsePerfData\""
        }
    }
    withName: '.*MUTECT_GATK_TN:GATK4_SPLITINTERVALS' {
        ext.args = { "--scatter-count ${meta.variant_calling_partitions}" }
    }
    withName: '.*MUTECT_GATK_TN:GATK4_MUTECT2' {
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
        ext.args2 = {
            def avail_mem = 3072
            if (task.memory) { avail_mem = (task.memory.mega * 0.8).intValue() }
            "--java-options \"-Xmx${avail_mem}M -XX:-UsePerfData\""
        }
        ext.args = {
            def args = []
            args << '--minimum-mapping-quality 1'
            args << '--min-base-quality-score 35'
            args << '--f1r2-median-mq 1'
            args << '--base-quality-score-threshold 35'
            args << '--initial-tumor-lod -5'
            args << '--tumor-lod-to-emit -5'
            args << '--pruning-lod-threshold -9'
            args << '--max-reads-per-alignment-start 0'
            args << '--active-probability-threshold 0.00005'
            args << '--smith-waterman FASTEST_AVAILABLE'
            args << '-A AssemblyComplexity'
            args << '-A TandemRepeat'
            args << '--min-pruning 2'
            args << '--max-mnp-distance 0'
            args << '--min-dangling-branch-length 0'
            args << '--allow-non-unique-kmers-in-ref true'
            args << '--enable-dynamic-read-disqualification-for-genotyping true'
            args << '--recover-all-dangling-branches true'
            args << '--linked-de-bruijn-graph false'
            args << '--pileup-detection false'
            args << '--create-output-bam-index true'
            args << '--create-output-bam-md5 false'
            args << '--create-output-variant-index true'
            args << '--create-output-variant-md5 false'
            args << '--genotype-germline-sites true'
            args << '--normal-lod 2.2'
            args << "${meta.tumor_id ? "--tumor ${meta.tumor_id}" : ''}"
            args << "${meta.normal_id ? "--normal ${meta.normal_id}" : ''}"
            args << "--native-pair-hmm-threads '${task.cpus}'"
            args << "--bam-writer-type CALLED_HAPLOTYPES"
            return args.join(' \\\n')
        }
    }
    withName: '.*MUTECT_PARABRICKS_TN:GATK4_SPLITINTERVALS' {
        ext.args = { "--scatter-count ${meta.variant_calling_partitions}" }
    }
    withName: '.*MUTECT_PARABRICKS_TN:PARABRICKS_MUTECTCALLER' {
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
        ext.args2 = { "--force --tbi --threads ${task.cpus}" }
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = (task.cpus / (task.accelerator ? task.accelerator.request : 1)) as int
            def gpu_args = use_low_memory
                ? '--mutect-low-memory'
                : ''
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            if (normal_bam && meta.normal_id) {
                args << "--in-normal-bam ${normal_bam}"
                args << "--normal-name ${meta.normal_id}"
            }
            args << "--minimum-mapping-quality 1"
            args << "--min-base-quality-score 35"
            args << "--f1r2-median-mq 1"
            args << "--base-quality-score-threshold 35"
            args << "--allow-non-unique-kmers-in-ref"
            args << "--enable-dynamic-read-disqualification-for-genotyping"
            args << "--recover-all-dangling-branches"
            args << "--mutectcaller-options '-A AssemblyComplexity -min-dangling-branch-length 0 -max-reads-per-alignment-start 0'"
            args << "--filter-reads-too-long"
            args << "--active-probability-threshold 0.00005"
            args << "--pruning-lod-threshold -9"
            args << "--tumor-lod-to-emit -5"
            args << "--initial-tumor-lod -5"
            args << "--max-mnp-distance 0"
            args << "--genotype-germline-sites"
            args << "--normal-lod 2.2"
            args << gpu_args
            args << "--num-htvc-threads ${num_threads}"
            return args.join(' \\\n')
        }
    }
    withName: '.*CALL_SOMATIC_VARIANTS_TN:BCFTOOLS_CONCAT' {
        ext.args = "--output-type z --write-index=tbi --allow-overlaps"
    }
    withName: '.*CALL_SOMATIC_VARIANTS_TN:BCFTOOLS_INDEX' {
        ext.args = "--tbi"
    }
    withName: BCFTOOLS_REHEADER_RENAME_TUMOR_SAMPLE {
        ext.prefix = { "${meta.id}_tumor_renamed" }
        ext.args2 = { "--output-type z --write-index=tbi --samples ${meta.id}" }
    }
    withName: XOOS_COPY_NUMBER_CALLER_TUMOR_NORMAL_WGS {
        ext.args = { "--threads ${task.cpus}" }
    }
    withName: XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_TUMOR_NORMAL_WGS {
        ext.args = { "--threads ${task.cpus}" }
    }
}
