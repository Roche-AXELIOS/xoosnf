includeConfig '../mitochondrial_bam_post_process/nextflow.config'

process {
    withName: 'GATK4_MUTECT2_MITOCHONDRIAL' {
        ext.prefix = { "${meta.id}_${params.giraffe_mitochondrial_bam_post_process_chrm_name}" }
        ext.args2 = {
            def avail_mem = 3072
            if (task.memory) { avail_mem = (task.memory.mega * 0.8).intValue() }
            "--java-options \"-Xmx${avail_mem}M -XX:-UsePerfData\""
        }
        ext.args = {
            def args = []
            args << '--mitochondria-mode'
            args << "-L ${params.giraffe_mitochondrial_bam_post_process_chrm_name}"
            args << '--max-mnp-distance 0'
            args << '--min-base-quality-score 23'
            args << '-RF MappingQualityReadFilter --minimum-mapping-quality 1'
            args << '--bam-writer-type CALLED_HAPLOTYPES'
            args << '--create-output-bam-index true'
            args << '--create-output-variant-index true'
            return args.join(' \\\n')
        }
    }

    withName: 'PARABRICKS_MUTECTCALLER_MITOCHONDRIAL' {
        ext.prefix = { "${meta.id}_${params.giraffe_mitochondrial_bam_post_process_chrm_name}" }
        ext.args = {
            def args = []
            args << "--tumor-name ${meta.id}"
            args << '--mitochondria-mode'
            args << "--interval ${params.giraffe_mitochondrial_bam_post_process_chrm_name}"
            args << '--filter-reads-too-long'
            args << '--max-mnp-distance 0'
            args << '--min-base-quality-score 23'
            args << '--minimum-mapping-quality 1'
            return args.join(' \\\n')
        }
        ext.args2 = { '--force --tbi' }
    }

    withName: 'BCFTOOLS_REHEADER_MITOCHONDRIAL' {
        ext.prefix = { "${meta.id}_${params.giraffe_mitochondrial_bam_post_process_chrm_name}_reheadered" }
        ext.args2 = { "--output-type z --write-index=tbi" }
    }
}
