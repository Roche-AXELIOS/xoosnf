                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                // XOOS markdup adds a `_markdup` suffix to the BAM filename so
                // the lack of the `_markdup` suffix indicates that the BAM bypassed the markdup step
                { assert workflow.out.bam[0][1].toString().endsWith('HG001.bam') },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

