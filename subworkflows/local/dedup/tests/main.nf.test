nextflow_workflow {

    name "Test DEDUP subworkflow"
    script "../main.nf"
    workflow "DEDUP"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "dedup"
    tag "xoos_read_collapser"

    test("stub - markdup strategy with bwa aligner") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'markdup'
                input[1] = 'bwa'
                input[2] = false
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

    test("stub - markdup strategy with pb_fq2bam aligner, pb_markdup BAM is re-marked") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'markdup'
                input[1] = 'pb_fq2bam'
                input[2] = false
                // Parabricks-marked input is re-marked by XOOS read_collapser.
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', bam_dedup_type: 'pb_markdup', bam_secondary_rescued: false], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                // XOOS markdup adds a `_markdup` suffix to the BAM filename so
                // the presence of the `_markdup` suffix indicates that the BAM has been re-marked
                { assert workflow.out.bam[0][1].toString().endsWith('HG001_markdup.bam') },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

    test("stub - markdup strategy with pb_giraffe aligner, rescue not required, sas_markdup BAM is re-marked") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'markdup'
                input[1] = 'pb_giraffe'
                input[2] = false
                // SAS-marked input is deliberately re-marked by XOOS read_collapser.
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', bam_dedup_type: 'sas_markdup', bam_secondary_rescued: false], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                // XOOS markdup adds a `_markdup` suffix to the BAM filename so
                // the presence of the `_markdup` suffix indicates that the BAM has been re-marked
                { assert workflow.out.bam[0][1].toString().endsWith('HG001_markdup.bam') },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

    test("stub - markdup strategy with pb_giraffe aligner, rescue required, raw BAM runs secondary rescue and markdup") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'markdup'
                input[1] = 'pb_giraffe'
                input[2] = true
                // An unrescued BAM must run secondary rescue before MARKDUP.
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', bam_dedup_type: 'none', bam_secondary_rescued: false], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                { assert workflow.out.bam[0][0].bam_secondary_rescued },
                // XOOS markdup adds a `_markdup` suffix to the BAM filename so
                // the presence of the `_markdup` suffix indicates that the BAM has been re-marked
                { assert workflow.out.bam[0][1].toString().endsWith('HG001_markdup.bam') },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

    test("stub - markdup strategy with pb_fq2bam aligner, raw BAM input runs markdup") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'markdup'
                input[1] = 'pb_fq2bam'
                input[2] = false
                // An unmarked BAM arrives with bam_dedup_type 'none' and must be
                // marked by the read collapser.
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', bam_dedup_type: 'none', bam_secondary_rescued: false], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                { assert snapshot(workflow.out.bam).match() },
                { assert workflow.out.bam[0][1].toString().endsWith('HG001_markdup.bam') },
            )
        }
    }

    test("stub - consensus strategy") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'consensus'
                input[1] = 'bwa'
                input[2] = false
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [id: 'bwa_idx'], file("\${testDataDir}/resources/bwa_ref") ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

    test("stub - xoos_markdup input bypasses markdup when rescue is not required") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'markdup'
                input[1] = 'bwa'
                input[2] = false
                input[3] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', bam_dedup_type: 'xoos_markdup', bam_secondary_rescued: false], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[4] = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[6] = Channel.value([ [], [] ])
                input[7] = Channel.value([ [], [], [] ])
                input[8] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam },
                // XOOS markdup adds a `_markdup` suffix to the BAM filename so
                // the lack of the `_markdup` suffix indicates that the BAM bypassed the markdup step
                { assert workflow.out.bam[0][1].toString().endsWith('HG001.bam') },
                { assert snapshot(workflow.out.bam).match() }
            )
        }
    }

    test("stub - xoos_secondary_rescue_and_markdup input bypasses both rescue and markdup") {
        options "-stub"

