process {
    withName: XOOS_READ_COLLAPSER_RESCUE_SECONDARY {
        ext.args = {
            def args = []
            args << "--threads ${task.cpus}"
            if (params.rescue_secondary_min_alignment_score_ratio != null) {
                args << "--min-alignment-score-ratio ${params.rescue_secondary_min_alignment_score_ratio}"
            }
            return args.join(' \\\n')
        }
    }
    withName: XOOS_READ_COLLAPSER_MARK_DUPLICATES {
        ext.args = {
            def args = []
            args << "--merge-output"
            args << "--threads ${task.cpus}"
            if (params.read_collapser_preset) {
                args << "--preset ${params.read_collapser_preset}"
            }
            if (params.read_collapser_cluster_by_umi.toBoolean()) {
                args << '--cluster-by-umi'
            }
            if (params.read_collapser_ignore_read_name_parsing_errors.toBoolean()) {
                args << '--ignore-read-name-parsing-errors'
            }
            return args.join(' \\\n')
        }
    }
    withName: XOOS_READ_COLLAPSER_CONSENSUS {
        ext.args = {
            def args = []
            args << "--threads ${task.cpus}"
            if (params.read_collapser_preset) { args << "--preset ${params.read_collapser_preset}" }
            if (params.exclude_partial_reads.toBoolean()) { args << '--exclude-partial-reads' }
            if (params.read_collapser_ignore_read_name_parsing_errors.toBoolean()) {
                args << '--ignore-read-name-parsing-errors'
            }
            return args.join(' \\\n')
        }
    }
}
