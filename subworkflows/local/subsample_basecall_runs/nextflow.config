process {
    // 1. SUBSAMPLE_BASECALL_RDB Configuration
    withName: '.*:SUBSAMPLE_BASECALL_RDB' {
        ext.args = {
            def args = ["--run-type 'basecall_rdb'"]

            if (params.subsample_run_ratio) {
                args << "--ratio '${params.subsample_run_ratio}'"
            }
            if (params.subsample_run_copy_mode) {
                args << "--copy-mode '${params.subsample_run_copy_mode}'"
            }
            if (params.subsample_run_strategy) {
                args << "--strategy '${params.subsample_run_strategy}'"
            }
            if (params.subsample_run_absolute_size) {
                args << "--absolute-size '${params.subsample_run_absolute_size}'"
            }

            return args.join(' \\\n').trim()
        }
    }

    // 2. SUBSAMPLE_BASECALL_FASTQ Configuration
    withName: '.*:SUBSAMPLE_BASECALL_FASTQ' {
        ext.args = {
            def args = ["--run-type 'fastq'"]

            if (params.subsample_run_ratio) {
                args << "--ratio '${params.subsample_run_ratio}'"
            }
            if (params.subsample_run_copy_mode) {
                args << "--copy-mode '${params.subsample_run_copy_mode}'"
            }
            if (params.subsample_run_strategy) {
                args << "--strategy '${params.subsample_run_strategy}'"
            }
            if (params.subsample_run_absolute_size) {
                args << "--absolute-size '${params.subsample_run_absolute_size}'"
            }

            return args.join(' \\\n').trim()
        }
    }
}
