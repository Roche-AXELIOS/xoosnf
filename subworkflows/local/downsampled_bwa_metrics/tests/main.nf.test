nextflow_workflow {

    name "Test DOWNSAMPLED_BWA_METRICS subworkflow"
    script "../main.nf"
    workflow "DOWNSAMPLED_BWA_METRICS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "downsampled_bwa_metrics"
    tag "subsample"
    tag "seqkit"
    tag "bwa"
    tag "pb_fq2bam"
    tag "metrics"

    test("stub - bwa aligner") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().fastqs().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/fastq/HG001") ]
                )
                input[1]  = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[2]  = Channel.value([ [id: 'bwa_idx'], file("\${testDataDir}/resources/bwa_ref") ])
                input[3]  = Channel.value([ [id: 'autosomes_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[4]  = Channel.value([ [], [] ])
                input[5]  = Channel.value([ [], [] ])
                input[6]  = Channel.value([ [], [] ])
                input[7]  = Channel.value([ [], [] ])
                input[8]  = Channel.value([ [id: 'reference_for_metrics'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[9]  = true   // enable_alignment_metrics_autosomes
                input[10] = false  // enable_alignment_metrics_targets
                input[11] = false  // enable_alignment_metrics_high_confidence
                input[12] = false  // enable_gc_bias_metrics
                input[13] = false  // enable_hs_metrics
                input[14] = 1000   // downsampled_bwa_metrics_read_count
                input[15] = 'bwa'  // downsampled_bwa_metrics_aligner
                input[16] = []     // additional_bed_files
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.report },
                { assert snapshot(workflow.out.report).match() }
            )
        }
    }

    test("stub - pb_fq2bam aligner") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().fastqs().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/fastq/HG001") ]
                )
                input[1]  = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[2]  = Channel.value([ [id: 'bwa_idx'], file("\${testDataDir}/resources/bwa_ref") ])
                input[3]  = Channel.value([ [id: 'autosomes_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[4]  = Channel.value([ [], [] ])
                input[5]  = Channel.value([ [], [] ])
                input[6]  = Channel.value([ [], [] ])
                input[7]  = Channel.value([ [], [] ])
                input[8]  = Channel.value([ [id: 'reference_for_metrics'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[9]  = true        // enable_alignment_metrics_autosomes
                input[10] = false       // enable_alignment_metrics_targets
                input[11] = false       // enable_alignment_metrics_high_confidence
                input[12] = false       // enable_gc_bias_metrics
                input[13] = false       // enable_hs_metrics
                input[14] = 1000        // read_count
                input[15] = 'pb_fq2bam' // aligner
                input[16] = []          // additional_bed_files
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.report },
                { assert snapshot(workflow.out.report).match() }
            )
        }
    }
}
