/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config for DOWNSAMPLED_BWA_METRICS subworkflow
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: '.*DOWNSAMPLED_BWA_METRICS:SUBSAMPLE_FASTQ_RANDOM' {
        ext.args = {
            def args = []
            args << "-s ${params.downsampled_bwa_metrics_seed}"
            return args.join(' \\\n')
        }
    }
}
