process {
    withName: XOOS_ALIGNMENT_METRICS_COVERAGE {
        ext.args = {
            def args = []
            args << "--threads ${task.cpus}"
            args << "--min-mapq ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-baseq ${params.alignment_metrics_min_base_quality}"
            args.join(' \\\n')
        }
    }
    withName: SAMTOOLS_VIEW {
        // Index writing and subsampling command are necessary
        ext.args = { "--subsample ${meta.subsample_fraction}" }
        ext.prefix = { "${meta.id}_subsampled" }
    }
}
