nextflow_function {

    name "Test Functions"
    script "subworkflows/local/utils_nfcore_xoos_pipeline/main.nf"
    tag 'subworkflows'
    tag 'utils_nfcore_xoos_pipeline'
    tag 'subworkflows/utils_nfcore_xoos_pipeline'

    test("copyNumberCallerAlignerWarning - pb_giraffe with copy number calling warns") {

        function "copyNumberCallerAlignerWarning"

        when {
            function {
                """
                input[0] = 'pb_giraffe'
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // pb_giraffe (Parabricks pbrun giraffe) cannot emit secondary
                // alignments, so enabling copy number calling must warn that the
                // secondary-alignment rescue step still runs but has nothing to
                // rescue (a no-op).
                { assert function.result.contains("Copy number calling is enabled with the 'pb_giraffe' aligner") },
                { assert function.result.contains("--max-multimaps") },
                { assert function.result.contains("still runs") },
                { assert function.result.contains("Use the 'vg_giraffe' aligner") }
            )
        }
    }

    test("copyNumberCallerAlignerWarning - pb_giraffe without copy number calling is silent") {

        function "copyNumberCallerAlignerWarning"

        when {
            function {
                """
                input[0] = 'pb_giraffe'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("copyNumberCallerAlignerWarning - vg_giraffe with copy number calling is silent") {

        function "copyNumberCallerAlignerWarning"

        when {
            function {
                """
                input[0] = 'vg_giraffe'
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // vg_giraffe supports --max-multimaps, so it emits secondary
                // alignments and must not trigger the pb_giraffe warning.
                { assert function.result == null }
            )
        }
    }
}
