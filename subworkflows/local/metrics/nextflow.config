process {
    withName: PICARD_COLLECT_GC_BIAS_METRICS {
        ext.args  = '--ALSO_IGNORE_DUPLICATES --VALIDATION_STRINGENCY LENIENT'
        ext.args2 = {
            def avail_mem = 3072
            if (task.memory) { avail_mem = (task.memory.mega * 0.8).intValue() }
            "-Xmx${avail_mem}M"
        }
    }
    withName: PICARD_COLLECTHSMETRICS {
        container = "ghcr.io/roche-csi/picard:3.4.0-roche.1"
        ext.args = '--TMP_DIR . --VALIDATION_STRINGENCY LENIENT'
    }

    // For duplex run types, alignment metrics
    // should be run with the additional `--min-base-type concordant` filter for
    //   - pre-dedup metrics
    //   - dedup / subsample metrics when the dedup strategy is not 'consensus'
    //     (consensus reads don't have YC tags so cannot infer base type)

    // Post-dedup or subsampled high confidence metrics
    withName: ALIGNMENT_METRICS_HIGH_CONFIDENCE {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def is_consensus = (params.dedup_strategy == 'consensus')
            def args = []
            args << "--threads ${task.cpus}"
            args << "--min-mapq ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-baseq ${params.alignment_metrics_min_base_quality}"
            args << "--max-alt-allele-fraction ${meta3.is_fallback ? 0.1 : 1.0}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-hp-metrics" : "")
            args << ((is_duplex && !is_consensus) ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }
    // Post-dedup or subsampled autosomal and target metrics
    withName: 'XOOS_ALIGNMENT_METRICS_ALL|ALIGNMENT_METRICS_AUTOSOMES|ALIGNMENT_METRICS_TARGETS' {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def is_consensus = (params.dedup_strategy == 'consensus')
            def args = []
            args << "--threads ${task.cpus}"
            args << "--min-mapq ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-baseq ${params.alignment_metrics_min_base_quality}"
            args << "--max-alt-allele-fraction ${params.alignment_metrics_max_alt_allele_fraction}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.alignment_metrics_coverage_bins ? "--coverage-cutoffs ${params.alignment_metrics_coverage_bins}" : "")
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-hp-metrics" : "")
            args << ((is_duplex && !is_consensus) ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }
    // Pre-dedup high confidence metrics
    withName: 'XOOS:PRE_DEDUP_METRICS:METRICS_ALIGNMENT:ALIGNMENT_METRICS_HIGH_CONFIDENCE' {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def args = []
            args << "--threads ${task.cpus}"
            args << "--min-mapq ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-baseq ${params.alignment_metrics_min_base_quality_pre_dedup}"
            args << "--max-alt-allele-fraction ${meta3.is_fallback ? 0.1 : 1.0}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-hp-metrics" : "")
            args << (is_duplex ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }
    // Pre-dedup autosomal and target metrics
    withName: 'XOOS:PRE_DEDUP_METRICS:METRICS_ALIGNMENT:(ALIGNMENT_METRICS_AUTOSOMES|ALIGNMENT_METRICS_TARGETS)' {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def args = []
            args << "--threads ${task.cpus}"
            args << "--min-mapq ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-baseq ${params.alignment_metrics_min_base_quality_pre_dedup}"
            args << "--max-alt-allele-fraction ${params.alignment_metrics_max_alt_allele_fraction}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.alignment_metrics_coverage_bins ? "--coverage-cutoffs ${params.alignment_metrics_coverage_bins}" : "")
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-hp-metrics" : "")
            args << (is_duplex ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }

    withName: '.*:CONTAMINATION_DETECTION:XOOS_TUMOR_FRACTION_ESTIMATOR_CONTAMINATION_DETECTION' {
        ext.args = "--enable-noise-estimation"
    }
}
