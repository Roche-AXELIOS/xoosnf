process {
    withName: XOOS_ALIGNMENT_METRICS_GC_BIAS {
        ext.args = { "--min-mapping-quality ${params.alignment_metrics_min_mapping_quality}" }
    }
    withName: PICARD_COLLECTHSMETRICS {
        ext.args = "--TMP_DIR . --VALIDATION_STRINGENCY LENIENT --MINIMUM_MAPPING_QUALITY ${params.alignment_metrics_min_mapping_quality}"
    }

    // For duplex run types, alignment metrics
    // should be run with the additional `--min-base-type concordant` filter for
    //   - pre-dedup metrics
    //   - dedup / subsample metrics when the dedup strategy is not 'consensus'
    //     (consensus reads don't have YC tags so cannot infer base type)

    // Post-dedup or subsampled high confidence metrics
    withName: ALIGNMENT_METRICS_HIGH_CONFIDENCE {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_i7_HPSID_duplex_v0', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def is_consensus = (params.dedup_strategy == 'consensus')
            def args = []
            args << "--min-mapping-quality ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-base-quality ${params.alignment_metrics_min_base_quality}"
            args << "--max-alt-allele-fraction ${meta3.is_fallback ? 0.1 : 1.0}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-homopolymer-metrics" : "")
            args << ((is_duplex && !is_consensus) ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }
    // Post-dedup or subsampled stratified metrics (autosomes, targets, additional regions)
    withName: 'ALIGNMENT_METRICS_STRATIFIED' {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_i7_HPSID_duplex_v0', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def is_consensus = (params.dedup_strategy == 'consensus')
            def target_regions_only = (meta1.region_labels == ['targets'])
            def args = []
            args << "--min-mapping-quality ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-base-quality ${params.alignment_metrics_min_base_quality}"
            args << "--max-alt-allele-fraction ${params.alignment_metrics_max_alt_allele_fraction}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.alignment_metrics_coverage_bins ? "--coverage-distribution-cutoffs ${params.alignment_metrics_coverage_bins}" : "")
            args << ((params.enable_target_enrichment_metrics.toBoolean() && target_regions_only) ? "--enable-target-enrichment-metrics" : "")
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-homopolymer-metrics" : "")
            args << ((is_duplex && !is_consensus) ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }
    // Pre-dedup high confidence metrics
    withName: 'XOOS:PRE_DEDUP_METRICS:METRICS_ALIGNMENT:ALIGNMENT_METRICS_HIGH_CONFIDENCE' {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_i7_HPSID_duplex_v0', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def args = []
            args << "--min-mapping-quality ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-base-quality ${params.alignment_metrics_min_base_quality_pre_dedup}"
            args << "--max-alt-allele-fraction ${meta3.is_fallback ? 0.1 : 1.0}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-homopolymer-metrics" : "")
            args << (is_duplex ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }
    // Pre-dedup stratified metrics (autosomes, targets, additional regions)
    withName: 'XOOS:PRE_DEDUP_METRICS:METRICS_ALIGNMENT:ALIGNMENT_METRICS_STRATIFIED' {
        ext.args = {
            def is_duplex = (meta1.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_i7_HPSID_duplex_v0', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def target_regions_only = (meta1.region_labels == ['targets'])
            def args = []
            args << "--min-mapping-quality ${params.alignment_metrics_min_mapping_quality}"
            args << "--min-base-quality ${params.alignment_metrics_min_base_quality_pre_dedup}"
            args << "--max-alt-allele-fraction ${params.alignment_metrics_max_alt_allele_fraction}"
            args << "--min-depth ${params.alignment_metrics_min_depth}"
            args << (params.alignment_metrics_coverage_bins ? "--coverage-distribution-cutoffs ${params.alignment_metrics_coverage_bins}" : "")
            args << ((params.enable_target_enrichment_metrics.toBoolean() && target_regions_only) ? "--enable-target-enrichment-metrics" : "")
            args << (params.enable_hp_metrics.toBoolean() ? "--enable-homopolymer-metrics" : "")
            args << (is_duplex ? "--min-base-type concordant" : "")
            args.join(' \\\n')
        }
    }

    withName: '.*:CONTAMINATION_DETECTION:XOOS_TUMOR_FRACTION_ESTIMATOR_CONTAMINATION_DETECTION' {
        ext.args = {
            def is_duplex = (meta.run_type in ['SBX-D', 'SBX-FAST', 'I2X_HPSID_v0.01', 'I2X_HPSID_v0.00', 'I2X_HPU_v0.11', 'I2X_HPU_v0.10'])
            def args = []
            args << "--enable-noise-estimation"
            // Setting base quality and base type based on duplex status and deduplication strategy
            // Duplex with consensus -> simplex + Q30
            // Duplex without consensus -> concordant + Q39
            // Simplex with consensus -> simplex + Q30
            // Simplex without consensus -> simplex + Q0
            args << (params.dedup_strategy == 'consensus'
                ? "--min-base-type simplex --min-base-quality 30"
                : (is_duplex ? "--min-base-type concordant --min-base-quality 39" : "--min-base-type simplex --min-base-quality 0")
            )
            args.join(' \\\n')
        }
    }
}
