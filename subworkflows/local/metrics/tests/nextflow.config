process {
    withName: 'XOOS_ALIGNMENT_METRICS_ALL|XOOS_ALIGNMENT_METRICS_ALL_STRATIFIED|XOOS_ALIGNMENT_METRICS_GC_BIAS|XOOS_MERGE_AND_LABEL_BED' {
        container = null
        cpus = 1
        memory = 1.GB
        beforeScript = 'ln -sf /usr/bin/true alignment_metrics && ln -sf /usr/bin/true merge_and_label_bed && export PATH=$PWD:$PATH'
    }
    withName: 'XOOS_PARSE_ALIGNMENT_METRICS|XOOS_PARSE_ALIGNMENT_METRICS_GC_BIAS|XOOS_PARSE_HS_METRICS' {
        container = null
        beforeScript = 'ln -sf /usr/bin/true generate-metrics-report && export PATH=$PWD:$PATH'
    }
    withName: 'XOOS_ALIGNMENT_METRICS_TO_MULTIQC|XOOS_GC_BIAS_METRICS_TO_MULTIQC' {
        container = null
        beforeScript = 'ln -sf /usr/bin/true xoos_to_multiqc.py && export PATH=$PWD:$PATH'
    }
    withName: 'PICARD_CREATESEQUENCEDICTIONARY|PICARD_COLLECTHSMETRICS' {
        container = null
        cpus = 1
        memory = 1.GB
    }
}
