nextflow_workflow {

    name "Test METRICS subworkflow"
    script "../main.nf"
    workflow "METRICS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "metrics"
    tag "xoos_alignment_metrics"
    tag "xoos_generate_metrics_report"
    tag "xoos_metrics_to_multiqc"
    tag "picard"

    test("stub - alignment metrics only") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = 'dedup'
                input[1]  = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[2]  = Channel.value([ [id: 'autosomes_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[3]  = Channel.value([ [], [] ])
                input[4]  = Channel.value([ [], [] ])
                input[5]  = Channel.value([ [], [], [], [] ])
                input[6]  = Channel.value([ [], [] ])
                input[7]  = Channel.value([ [id: 'reference_for_metrics'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[8]  = true   // enable_alignment_metrics_autosomes
                input[9]  = false  // enable_alignment_metrics_targets
                input[10] = false  // enable_alignment_metrics_high_confidence
                input[11] = false  // enable_gc_bias_metrics
                input[12] = false  // enable_hs_metrics
                input[13] = 'bwa'  // aligner
                input[14] = []     // additional_bed_files
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.report },
                { assert snapshot(workflow.out.report).match() }
            )
        }
    }

    test("stub - all metrics enabled") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = 'dedup'
                input[1]  = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[2]  = Channel.value([ [id: 'autosomes_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[3]  = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[4]  = Channel.value([ [id: 'capture_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[5]  = Channel.value([ [], [], [], [] ])
                input[6]  = Channel.value([ [], [] ])
                input[7]  = Channel.value([ [id: 'reference_for_metrics'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[8]  = true   // enable_alignment_metrics_autosomes
                input[9]  = true   // enable_alignment_metrics_targets
                input[10] = false  // enable_alignment_metrics_high_confidence
                input[11] = true   // enable_gc_bias_metrics
                input[12] = true   // enable_hs_metrics
                input[13] = 'bwa'  // aligner
                input[14] = []     // additional_bed_files
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.report },
                { assert workflow.out.custom_multiqc_files.any { output -> output[1].toString().endsWith('HG001_dedup_gc_bias_multiqc_input') } },
                { assert snapshot(workflow.out.report).match() }
            )
        }
    }

    test("stub - HS metrics use target BED when capture BED is absent") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = 'dedup'
                input[1]  = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[2]  = Channel.value([ [], [] ])
                input[3]  = Channel.value([ [id: 'target_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[4]  = Channel.value([ [], [] ])
                input[5]  = Channel.value([ [], [], [], [] ])
                input[6]  = Channel.value([ [], [] ])
                input[7]  = Channel.value([ [id: 'reference_for_metrics'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[8]  = false  // enable_alignment_metrics_autosomes
                input[9]  = false  // enable_alignment_metrics_targets
                input[10] = false  // enable_alignment_metrics_high_confidence
                input[11] = false  // enable_gc_bias_metrics
                input[12] = true   // enable_hs_metrics
                input[13] = 'bwa'  // aligner
                input[14] = []     // additional_bed_files
                """
            }
        }

        then {
            def combined = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.success },
                { assert workflow.out.report },
                { assert combined.contains('capture_bed was not provided; using target_bed for HS metrics') },
                { assert combined.contains('On-bait metrics may be inaccurate') }
            )
        }
    }

    test("stub - with additional alignment metrics") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().bams().root()
            new File("${projectDir}/test-data-stub/resources/bwa_ref/vntr.bed").text = ''
            new File("${projectDir}/test-data-stub/resources/bwa_ref/tr.bed.gz").text = ''
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = 'dedup'
                input[1]  = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'], file("\${testDataDir}/inputs/bam/HG001.bam"), file("\${testDataDir}/inputs/bam/HG001.bam.bai") ]
                )
                input[2]  = Channel.value([ [id: 'autosomes_bed'], file("\${testDataDir}/resources/bwa_ref/test.autosomes.bed") ])
                input[3]  = Channel.value([ [], [] ])
                input[4]  = Channel.value([ [], [] ])
                input[5]  = Channel.value([ [], [], [], [] ])
                input[6]  = Channel.value([ [], [] ])
                input[7]  = Channel.value([ [id: 'reference_for_metrics'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[8]  = true   // enable_alignment_metrics_autosomes
                input[9]  = false  // enable_alignment_metrics_targets
                input[10] = false  // enable_alignment_metrics_high_confidence
                input[11] = false  // enable_gc_bias_metrics
                input[12] = false  // enable_hs_metrics
                input[13] = 'bwa'  // aligner
                input[14] = [
                    [region_name: 'vntr', bed: "\${testDataDir}/resources/bwa_ref/vntr.bed"],
                    [region_name: 'tr',   bed: "\${testDataDir}/resources/bwa_ref/tr.bed.gz"],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.report },
                { assert snapshot(workflow.out.report).match() }
            )
        }
    }
}
