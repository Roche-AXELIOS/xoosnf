process {
    withName: XOOS_BAM_POST_PROCESS_RECRUIT {
        ext.args = {
            def args = []
            args << "--anchor-pad ${params.giraffe_mitochondrial_bam_post_process_anchor_pad}"
            args << "--window ${params.giraffe_mitochondrial_bam_post_process_window}"
            args << "--chrm-name ${params.giraffe_mitochondrial_bam_post_process_chrm_name}"
            args << "--threads ${task.cpus}"
            return args.join(' \\\n')
        }
    }

    withName: VG_GIRAFFE_GAF {
        ext.args = {
            def args = []
            args << "--max-multimaps ${params.giraffe_mitochondrial_bam_post_process_multimap}"
            args << "-t ${task.cpus}"
            return args.join(' \\\n')
        }
    }

    withName: SAMTOOLS_VIEW_ORIGINAL_HEADER {
        ext.args = { "--header-only --output-fmt sam" }
        ext.prefix = { "${meta.id}.original-header" }
    }

    withName: SAMTOOLS_ADDREPLACERG_NFCORE {
        ext.args = { "-m overwrite_all" }
        ext.prefix = { "${meta.id}.chrM.with-rg" }
    }

    withName: XOOS_BAM_POST_PROCESS_CALL {
        ext.args = {
            def args = []
            args << "--window ${params.giraffe_mitochondrial_bam_post_process_window}"
            args << "--chrm-name ${params.giraffe_mitochondrial_bam_post_process_chrm_name}"
            args << "--threads ${task.cpus}"
            return args.join(' \\\n')
        }
    }

    withName: VG_SURJECT {
        ext.args = { "-G -b -u -t ${task.cpus}" }
    }

    withName: SAMTOOLS_SORT_NFCORE {
        ext.prefix = { "${meta.id}.chrM" }
    }
}
