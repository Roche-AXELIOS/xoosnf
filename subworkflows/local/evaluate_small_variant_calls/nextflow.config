process {
    withName: RTGTOOLS_FORMAT {
        ext.args2 = {
            def avail_mem = "3G"
            if (task.memory) { avail_mem = (task.memory.mega * 0.8).intValue() + "M" }
            "RTG_MEM=${avail_mem}"
        }
    }
    withName: RTGTOOLS_VCFEVAL {
        ext.args = {
            return '--decompose --ref-overlap -f GQ'
        }
        ext.args2 = {
            def avail_mem = "3G"
            if (task.memory) { avail_mem = (task.memory.mega * 0.8).intValue() + "M" }
            "RTG_MEM=${avail_mem}"
        }
    }
}
