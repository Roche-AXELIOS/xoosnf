process {
    withName: XOOS_DEMUX {
        ext.args = {
            def args = []
            args << "--adapter-design-bundle /resources/adapter-design-bundle.zip"
            args << "--compression-type gzip"
            args << "--threads ${task.cpus}"
            def is_simplex = meta.run_type in ['YS', 'YSU', 'YS-NEW']
            def read_length_mode = params.exclude_partial_reads.toBoolean()
                ? (is_simplex ? 'all-split' : 'full-only')
                : 'all'
            args << "--read-length-mode ${read_length_mode}"
            if (params.enable_demux_early_stop.toBoolean() && params.demux_early_stop_coverage_target) {
                def bases_per_1x = meta.run_type == 'SBX-FAST' ? 3333333333 : 3733333333
                def coverage_target = params.demux_early_stop_coverage_target as Long
                def min_bases = (bases_per_1x * coverage_target) as Long
                args << "--stop-after-min-concordant-duplex-bases ${min_bases}"
            }
            args.join(' \\\n')
        }
    }
}
