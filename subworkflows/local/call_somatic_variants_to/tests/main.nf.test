                { assert workflow.out.raw_vc_vcf.size() == 0 },
                { assert workflow.out.copy_number_caller_output.size() == 0 },
                { assert workflow.out.germline_filtering_output.size() == 0 }
            )
        }
    }

    test("stub - tumor-only MSI caller is included in merged VCF") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().variantCallingResources().bams().root()
        }

        when {
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0]  = Channel.of(
                    [
                        [id: 'sample1', run_name: 'test_run', run_type: 'SBX-D', tumor_id: 'HG002'],
                        [file("\${testDataDir}/inputs/bam/HG002.bam")],
                        [file("\${testDataDir}/inputs/bam/HG002.bam.bai")]
                    ]
                )
                input[1]  = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[2]  = Channel.value([ [id: 'reference_dict'], file("\${testDataDir}/resources/bwa_ref/test.dict") ])
                input[3]  = Channel.value([ [id: 'splitintervals_reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[4]  = Channel.value([ [id: 'splitintervals_reference_dict'], file("\${testDataDir}/resources/bwa_ref/test.dict") ])
                input[5]  = Channel.value([ [], [] ])  // intervals
                input[6]  = Channel.value([ [id: 'pop_af'], file("\${testDataDir}/resources/gatk-best-practices/hg38/af-only-gnomad.hg38.vcf.gz"), file("\${testDataDir}/resources/gatk-best-practices/hg38/af-only-gnomad.hg38.vcf.gz.tbi") ])
                input[7]  = Channel.value([ [id: 'svc_model_to'], file("\${testDataDir}/resources/variantCaller/svc_model_somatic_to.bin") ])
                input[8]  = Channel.value([ [], [], [] ])  // svc_somatic_to_panel_of_normals
                input[9]  = Channel.value([ [], [] ])  // truth_vcf_dir_tumor_only
                input[10] = Channel.value([ [], [] ])  // eval_bed_dir_tumor_only
                input[11] = Channel.value([ [], [] ])  // cnc_mappability_bw
                input[12] = Channel.value([ [], [] ])  // cnc_seed_seg
                input[13] = Channel.value([ [], [] ])  // cnc_somatic_tn_blocklist_bed
                input[14] = Channel.value([ [], [] ])  // cnc_somatic_to_snp_blocklist_bed
                input[15] = true   // enable_small_variant_caller
                input[16] = true   // use_gatk_mutect2
                input[17] = false  // enable_mutect_stats
                input[18] = false  // enable_vcfeval
                input[19] = false  // enable_copy_number_caller
                input[20] = false  // enable_germline_filtering
                input[21] = true   // enable_merge_vcf
                input[22] = null   // reference_sdf
                input[23] = true   // enable_partitioning
                input[24] = 2      // partition_count
                input[25] = Channel.value([ [], [] ])  // msi_background_threshold_json
                input[26] = true   // enable_msi_caller
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.msi_caller_output.size() == 1 },
                { assert workflow.out.msi_caller_output[0][0].id == 'sample1' },
                { assert workflow.out.merged_vcf.size() == 1 },
                { assert workflow.out.merged_vcf[0][0].groupSize == 2 },
            )
        }
    }

