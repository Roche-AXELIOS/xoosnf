                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', single_end: true], file("\${testDataDir}/inputs/fastq/HG001") ]
                )
                input[3] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[4] = Channel.value([ [], [] ])
                input[5] = Channel.value([ [], [], [] ])
                input[6] = Channel.value([])
                """
            }
