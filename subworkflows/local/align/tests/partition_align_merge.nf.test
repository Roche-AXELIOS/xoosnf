    test("stub - multiple samples with bwa") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").bwaRef().giraffeRef().fastqs().root()
        }

        when {
            params {
                enable_pangenome_personalization = false
                enable_alignment_partitioning    = true
                alignment_partition_count        = 2
                dedup_strategy                   = 'markdup'
            }
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = 'bwa'
                input[1] = 2
                input[2] = Channel.of(
                    [ [id: 'HG001', run_name: 'test_run', run_type: 'SBX-D', single_end: true], file("\${testDataDir}/inputs/fastq/HG001") ],
                    [ [id: 'HG002', run_name: 'test_run', run_type: 'SBX-D', single_end: true], file("\${testDataDir}/inputs/fastq/HG002") ]
                )
                input[3] = Channel.value([ [id: 'reference'], file("\${testDataDir}/resources/bwa_ref/test.fna"), file("\${testDataDir}/resources/bwa_ref/test.fna.fai") ])
                input[4] = Channel.value([ [id: 'bwa_idx'], file("\${testDataDir}/resources/bwa_ref") ])
                input[5] = Channel.value([ [], [], [] ])
                input[6] = Channel.value([])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bams },
                { assert workflow.out.giraffe_graphs.size() == 0 },
                // Should produce one merged BAM per sample
                { assert workflow.out.bams.size() == 2 },
                { assert workflow.out.bams.collect { it[0].id }.sort() == ['HG001', 'HG002'] },
                { assert snapshot(workflow.out.bams).match() }
            )
        }
    }
