nextflow_workflow {

    name "Test ALIGN_VG_GIRAFFE subworkflow"
    script "../align_vg_giraffe.nf"
    workflow "ALIGN_VG_GIRAFFE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "align"
    tag "vg/giraffe"

    test("stub - copy number calling enables VG Giraffe multimaps") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").giraffeRef().fastqs().root()
        }

        when {
            params {
                enable_copy_number_caller = true
                outdir                    = "$outputDir"
            }
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = Channel.of(
                    [ [id: 'HG001', sample_id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'],
                      file("\${testDataDir}/inputs/fastq/HG001"),
                      file("\${testDataDir}/resources/giraffe_ref/test.gbz"),
                      file("\${testDataDir}/resources/giraffe_ref/test.zipcodes"),
                      file("\${testDataDir}/resources/giraffe_ref/test.min"),
                      file("\${testDataDir}/resources/giraffe_ref/test.dist") ]
                )
                input[1] = Channel.value([])
                """
            }
        }

        then {
            def commandArgs = workflow.out.command_args[0][1].toString()
            def tokens = commandArgs.replaceAll(/\\\s*/, ' ').trim().tokenize()
            def flagIndex = tokens.indexOf('--max-multimaps')
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bams },
                { assert tokens.count('--max-multimaps') == 1 },
                { assert flagIndex >= 0 && tokens[flagIndex + 1] == '3' }
            )
        }
    }

    test("stub - copy number calling disabled omits VG Giraffe multimaps") {
        options "-stub"

        setup {
            TestFixture.under("${projectDir}/test-data-stub").giraffeRef().fastqs().root()
        }

        when {
            params {
                enable_copy_number_caller = false
                outdir                    = "$outputDir"
            }
            workflow {
                """
                def testDataDir = "\${projectDir}/test-data-stub"
                input[0] = Channel.of(
                    [ [id: 'HG001', sample_id: 'HG001', run_name: 'test_run', run_type: 'SBX-D'],
                      file("\${testDataDir}/inputs/fastq/HG001"),
                      file("\${testDataDir}/resources/giraffe_ref/test.gbz"),
                      file("\${testDataDir}/resources/giraffe_ref/test.zipcodes"),
                      file("\${testDataDir}/resources/giraffe_ref/test.min"),
                      file("\${testDataDir}/resources/giraffe_ref/test.dist") ]
                )
                input[1] = Channel.value([])
                """
            }
        }

        then {
            def commandArgs = workflow.out.command_args[0][1].toString()
            def tokens = commandArgs.replaceAll(/\\\s*/, ' ').trim().tokenize()
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bams },
                { assert !tokens.contains('--max-multimaps') }
            )
        }
    }
}
