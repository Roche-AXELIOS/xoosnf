process {
    withName: PARABRICKS_FQ2BAM_SINGLE_END_MULTIPLE_FASTQS {
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = Math.max(1, ((task.cpus / (task.accelerator ? task.accelerator.request : 1)) / (use_low_memory ? 2 : 1)) as int)
            // Parabricks markdup is enabled only when all three conditions hold:
            //   1. dedup_strategy is 'markdup'
            //   2. alignment partitioning is off (per-partition markdup is incorrect)
            //   3. enable_read_collapser_dedup is off (otherwise read_collapser handles it)
            // Keep in sync with the identical condition in PARABRICKS_GIRAFFE below.
            def markdup_args = (params.dedup_strategy == 'markdup' && !params.enable_alignment_partitioning.toBoolean() && !params.enable_read_collapser_dedup.toBoolean()) ? '--markdups-single-ended-start-end' : '--no-markdups'
            def gpu_args = use_low_memory
                ? '--low-memory'
                : '--gpuwrite --gpusort'
            args << '--monitor-usage'
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << markdup_args
            args << gpu_args
            args << "--bwa-cpu-thread-pool ${num_threads}"
            args << "--memory-limit ${(task.memory / 2).toGiga()}"
            // Keep comments and use soft clipping
            args << "--bwa-options '-C -Y'"
            args << '--read-group-pl SBX'
            args << "--read-group-lb ${meta.run_type}"
            if (params.max_parabricks_alignment_read_length) {
                args << "--max-read-length ${params.max_parabricks_alignment_read_length}"
            }
            return args.join(' \\\n')
        }
    }
    withName: PARABRICKS_GIRAFFE_SINGLE_END_MULTIPLE_FASTQS {
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = Math.max(1, ((task.cpus / (task.accelerator ? task.accelerator.request : 1)) / (use_low_memory ? 2 : 1)) as int)
            // Parabricks markdup is enabled only when all three conditions hold:
            //   1. dedup_strategy is 'markdup'
            //   2. alignment partitioning is off (per-partition markdup is incorrect)
            //   3. enable_read_collapser_dedup is off (otherwise read_collapser handles it)
            // Keep in sync with the identical condition in PARABRICKS_FQ2BAM above.
            def markdup_args = (params.dedup_strategy == 'markdup' && !params.enable_alignment_partitioning.toBoolean() && !params.enable_read_collapser_dedup.toBoolean()) ? '--markdups-single-ended-start-end' : '--no-markdups'
            def gpu_args = use_low_memory
                ? '--low-memory'
                : '--gpuwrite --gpusort --minimizers-gpu --nstreams 4'
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << markdup_args
            args << gpu_args
            args << "--num-cpu-threads-per-gpu ${num_threads}"
            args << "--memory-limit ${(task.memory * 0.75).toGiga()}"
            args << '--copy-comment'
            args << '--read-group-platform SBX'
            args << '--read-group-pu unknown'
            args << "--read-group-library ${meta.run_type}"
            if (params.max_parabricks_alignment_read_length) {
                args << "--max-read-length ${params.max_parabricks_alignment_read_length}"
            }
            return args.join(' \\\n')
        }
    }
    withName: VG_AUTOINDEX {
        ext.args = { "-w giraffe -t ${task.cpus}" }
    }
    withName: VG_HAPLOTYPES {
        ext.args = { "--include-reference --diploid-sampling -t ${task.cpus}" }
    }
    withName: VG_GIRAFFE {
        ext.args2 = { "-@ ${task.cpus} -l 1 --write-index" }
        ext.args = {
            def args = []
            args << "--output-format SAM"
            args << "-t ${task.cpus}"
            args << '--comments-as-tags'
            // vg giraffe defaults to --max-multimaps 1 (no secondary
            // alignments); raise it so copy number calling's rescue step has
            // secondaries to promote.
            if (params.enable_copy_number_caller.toBoolean()) {
                args << "--max-multimaps 3"
            }
            args << "--read-group '${meta.sample_id}'"
            args << "--sample '${meta.sample_id}	LB:${meta.run_type}	PL:SBX	PU:unknown'"
            return args.join(' \\\n')
        }
    }

    withName: BWA_MEM_SINGLE_END_MULTIPLE_FASTQS {
        ext.args2 = { "--threads ${task.cpus}" }
        ext.args = {
            def args = []
            args << "-t ${task.cpus}"
            args << '-c 300'
            args << '-K 40000000'
            args << '-C'
            args << '-Y'
            args << "-R '@RG\\tID:${meta.sample_id}\\tSM:${meta.sample_id}\\tLB:${meta.run_type}\\tPL:SBX\\tPU:unknown'"
            return args.join(' \\\n')
        }
    }
    withName: MINIMAP2_ALIGN {
        ext.args2 = { "--threads ${task.cpus}" }
        ext.args = {
            def args = []
            args << '-a'
            args << "-t ${task.cpus}"
            args << '-x sr'
            args << "-R '@RG\\tID:${meta.sample_id}\\tSM:${meta.sample_id}\\tLB:${meta.run_type}\\tPL:SBX\\tPU:unknown'"
            return args.join(' \\\n')
        }
    }
    withName: PARABRICKS_MINIMAP2 {
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = Math.max(1, ((task.cpus / (task.accelerator ? task.accelerator.request : 1)) / (use_low_memory ? 2 : 1)) as int)
            def gpu_args = use_low_memory
                ? '--low-memory'
                : '--gpuwrite --gpusort'
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << gpu_args
            args << "--num-threads ${num_threads}"
            args << '--read-group-pl SBX'
            args << "--read-group-lb ${meta.run_type}"
            args << "--read-group-id-prefix ${meta.sample_id}"
            return args.join(' \\\n')
        }
    }
    withName: KMC_KMER_COUNT {
        ext.args2 = { "--threads ${task.cpus}" }
        ext.args = {
            def args = []
            args << '-okff'
            args << "-t${task.cpus}"
            args << "-m${(task.memory * 0.75).toGiga()}"
            args << '-k29'
            args << '-sm'
            return args.join(' \\\n')
        }
    }

    withName: '.*:SUBSAMPLE_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/subsampled_fastqs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { "-j ${task.cpus}" }
    }

    withName: SAMBAMBA_MERGE {
        ext.args2 = { "-t ${task.cpus}" }
        ext.args = { "-t ${task.cpus} -l 1" }
    }
}
