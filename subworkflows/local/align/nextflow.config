process {
    withName: PARABRICKS_FQ2BAM_SINGLE_END_MULTIPLE_FASTQS {
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = Math.max(1, ((task.cpus / (task.accelerator ? task.accelerator.request : 1)) / (use_low_memory ? 2 : 1)) as int)
            def gpu_args = use_low_memory
                ? '--low-memory'
                : '--gpuwrite --gpusort'
            args << '--monitor-usage'
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << '--no-markdups'
            args << gpu_args
            args << "--bwa-cpu-thread-pool ${num_threads}"
            args << "--memory-limit ${(task.memory / 2).toGiga()}"
            // Keep comments and use soft clipping
            args << "--bwa-options '-C -Y'"
            // Read group (incl. PM) is passed as an inline @RG string on
            // --in-se-fq in the module, since Parabricks has no --read-group-pm
            // flag; do not add discrete --read-group-* flags here (they would
            // conflict with the inline @RG).
            if (params.max_parabricks_alignment_read_length) {
                args << "--max-read-length ${params.max_parabricks_alignment_read_length}"
                args << "--max-read-length-on-gpu ${params.max_parabricks_alignment_read_length}"
            }
            return args.join(' \\\n')
        }
    }
    withName: PARABRICKS_GIRAFFE_SINGLE_END_MULTIPLE_FASTQS {
        ext.args = {
            def args = []
            def sample_id = meta.sample_id ?: "${meta.id}"
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = Math.max(1, ((task.cpus / (task.accelerator ? task.accelerator.request : 1)) / (use_low_memory ? 2 : 1)) as int)
            def gpu_args = use_low_memory
                ? '--low-memory'
                : '--gpuwrite --gpusort --minimizers-gpu --nstreams 4'
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << '--no-markdups'
            args << gpu_args
            args << "--num-cpu-threads-per-gpu ${num_threads}"
            args << "--memory-limit ${(task.memory * 0.75).toGiga()}"
            args << '--copy-comment'
            args << '--read-group-platform SBX'
            args << '--read-group-pu unknown'
            args << "--read-group-library unknown.${meta.run_type}.${sample_id}"
            // Emit secondary alignments for the rescue step used by copy-number
            // calling. Supported by the pinned Parabricks 4.7.1-1 image.
            if (params.enable_copy_number_caller.toBoolean()) {
                args << '--max-multimaps 3'
            }
            return args.join(' \\\n')
        }
    }
    withName: VG_AUTOINDEX {
        ext.args = { '-w giraffe' }
    }
    withName: VG_HAPLOTYPES {
        ext.args = { '--include-reference --diploid-sampling' }
    }
    withName: VG_GIRAFFE {
        ext.args2 = { '-l 1 --write-index' }
        ext.args = {
            def args = []
            def sample_id = meta.sample_id ?: "${meta.id}"
            args << "--output-format SAM"
            args << '--comments-as-tags'
            // vg giraffe defaults to --max-multimaps 1 (no secondary
            // alignments); raise it so copy number calling's rescue step has
            // secondaries to promote.
            if (params.enable_copy_number_caller.toBoolean()) {
                args << "--max-multimaps 3"
            }
            args << "--read-group '${sample_id}'"
            args << "--sample '${sample_id}	LB:unknown.${meta.run_type}.${sample_id}	PL:SBX	PU:unknown	PM:AXELIOS_1'"
            return args.join(' \\\n')
        }
    }

    withName: BWA_MEM_SINGLE_END_MULTIPLE_FASTQS {
        ext.args = {
            def args = []
            def sample_id = meta.sample_id ?: "${meta.id}"
            args << '-c 300'
            args << '-K 40000000'
            args << '-C'
            args << '-Y'
            args << "-R '@RG\\tID:${sample_id}\\tSM:${sample_id}\\tLB:unknown.${meta.run_type}.${sample_id}\\tPL:SBX\\tPU:unknown\\tPM:AXELIOS_1'"
            return args.join(' \\\n')
        }
    }
    withName: MINIMAP2_ALIGN {
        ext.args = {
            def args = []
            def sample_id = meta.sample_id ?: "${meta.id}"
            args << '-a'
            args << '-x sr'
            args << "-R '@RG\\tID:${sample_id}\\tSM:${sample_id}\\tLB:unknown.${meta.run_type}.${sample_id}\\tPL:SBX\\tPU:unknown\\tPM:AXELIOS_1'"
            return args.join(' \\\n')
        }
    }
    withName: PARABRICKS_MINIMAP2 {
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def num_threads = Math.max(1, ((task.cpus / (task.accelerator ? task.accelerator.request : 1)) / (use_low_memory ? 2 : 1)) as int)
            def gpu_args = use_low_memory
                ? '--low-memory'
                : '--gpuwrite --gpusort'
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << '--no-markdups'
            args << gpu_args
            args << "--num-threads ${num_threads}"
            // Read group (incl. PM) is passed as an inline @RG string on --in-fq
            // in the module, since Parabricks has no --read-group-pm flag; do not
            // add discrete --read-group-* flags here (they would conflict with
            // the inline @RG).
            return args.join(' \\\n')
        }
    }
    withName: KMC_KMER_COUNT {
        ext.args = {
            def args = []
            args << '-okff'
            args << "-m${(task.memory * 0.75).toGiga()}"
            args << '-k29'
            args << '-sm'
            return args.join(' \\\n')
        }
    }

    withName: '.*:SUBSAMPLE_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/subsampled_fastqs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
