                input[19] = 'pb_giraffe'  // aligner
                input[20] = false         // enable_small_variant_caller_retrain
                input[21] = false         // enable_vcfeval
                input[22] = false         // enable_copy_number_caller
                input[23] = true   // enable_copy_number_caller_baf
                input[24] = false         // enable_str_caller
                input[25] = true          // enable_merge_vcf
                input[26] = null   // reference_sdf
                input[27] = true   // enable_partitioning
                input[28] = 2      // partition_count
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.merged_vcf },
                { assert snapshot(workflow.out.merged_vcf).match() }
            )
        }
    }

