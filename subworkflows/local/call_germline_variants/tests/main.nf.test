                input[12] = Channel.value([ [], [] ])  // eval_bed_dir
                input[13] = Channel.value([ [id: 'mappability_bw'], file("\${testDataDir}/resources/bwa_ref/test.bw") ])
                input[14] = Channel.value([ [id: 'cnv_seed_file'], file("\${testDataDir}/resources/bwa_ref/cnv_seed.bed") ])
                input[15] = Channel.value([ [], [] ])  // cnv_blocklist_bed
                input[16] = Channel.value([ [id: 'repeat_catalog'], file("\${testDataDir}/resources/STR/hg38/full_repeat_catalog.json") ])
                input[17] = true   // enable_small_variant_caller
                input[18] = true   // use_gatk_haplotype_caller
                input[19] = 'bwa'  // aligner
                input[20] = false  // enable_small_variant_caller_retrain
                input[21] = false  // enable_vcfeval
                input[22] = true   // enable_copy_number_caller
                input[23] = true   // enable_copy_number_caller_baf
                input[24] = true   // enable_str_caller
                input[25] = false  // enable_mitochondrial_variant_caller
                input[26] = false   // use_gatk_mutect2_mitochondrial
                input[27] = true   // enable_merge_vcf
                input[28] = null   // reference_sdf
                input[29] = true   // enable_partitioning
                input[30] = 2      // partition_count
                input[31] = Channel.empty()  // ch_giraffe_graphs
                input[32] = Channel.empty()  // ch_giraffe_chrm_paths
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.merged_vcf },
                { assert snapshot(workflow.out.merged_vcf).match() }
            )
        }
    }

