                """
            }
        }

        then {
            def strFiles = workflow.out.str_caller_output[0][1]
            def strJson = new File(strFiles.find { it.toString().endsWith('_str.json') }.toString()).text
            assertAll(
                { assert workflow.success },
                { assert workflow.out.str_caller_output },
                // non-giraffe aligner must omit --aligner so the caller auto-detects
                // from the BAM @PG header (the drop-in replacement for the removed
                // "nothing passed" --giraffe-input-bam behaviour). 'auto' is not a
                // valid --aligner value; the caller accepts {unknown, bwa, giraffe}.
                { assert !strJson.contains('--aligner') },
                { assert !strJson.contains('--giraffe-input-bam') }
            )
        }
    }
}
