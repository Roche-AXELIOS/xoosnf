                input[14] = Channel.value([ [id: 'cnv_seed_file'], file("\${testDataDir}/resources/bwa_ref/cnv_seed.bed") ])
                input[15] = Channel.value([ [id: 'repeat_catalog'], file("\${testDataDir}/resources/STR/hg38/full_repeat_catalog.json") ])
                input[16] = true   // enable_small_variant_caller
                input[17] = true   // use_gatk_haplotype_caller
                input[18] = false  // use_multisample_model
