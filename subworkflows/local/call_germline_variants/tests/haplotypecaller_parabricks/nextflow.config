process {
    withName: '.*HAPLOTYPECALLER_PARABRICKS:GATK4_SPLITINTERVALS' {
        ext.args = { "--scatter-count ${meta.variant_calling_partitions}" }
    }
    withName: PARABRICKS_HAPLOTYPECALLER {
        container = null
        ext.args = ''
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
        // Force multi-GPU so the stub emits per-GPU BAMs (*_hc_0.bam, *_hc_1.bam)
        accelerator = 2
    }
    withName: '.*HAPLOTYPECALLER_PARABRICKS:HTSLIB_BGZIPTABIX' {
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
    }
}

docker.enabled = false
singularity.enabled = false

// Prepend mock-bin directories so stubs can find mock pbrun and bgzip
env.PATH = "${projectDir}/subworkflows/local/call_germline_variants/tests/haplotypecaller_parabricks/mock-bin:${projectDir}/tests/mock-bin:\$PATH"
