process {
    withName: '.*HAPLOTYPECALLER_GATK:GATK4_SPLITINTERVALS' {
        ext.args = { "--scatter-count ${meta.variant_calling_partitions}" }
    }
    withName: '.*HAPLOTYPECALLER_PARABRICKS:GATK4_SPLITINTERVALS' {
        ext.args = { "--scatter-count ${meta.variant_calling_partitions}" }
    }
    withName: GATK4_HAPLOTYPECALLER {
        ext.args = {
            // --activeregion-alt-multiplier is omitted when the param is null
            // (e.g. simplex data, where the multiplier should not be used).
            def alt_multiplier = params.gatk_activeregion_alt_multiplier != null
                ? "--activeregion-alt-multiplier ${params.gatk_activeregion_alt_multiplier} "
                : ''
            "-OBI -OVI --bam-writer-type CALLED_HAPLOTYPES -A TandemRepeat -A AssemblyComplexity -RF MappingQualityReadFilter ${alt_multiplier}--adaptive-pruning --enable-dynamic-read-disqualification-for-genotyping true --mapping-quality-threshold-for-genotyping 1 --minimum-mapping-quality 1 --min-base-quality-score 6 --smith-waterman FASTEST_AVAILABLE"
        }
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
    }
    withName: '.*HAPLOTYPECALLER_PARABRICKS:TABIX_BGZIPTABIX' {
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
    }
    withName: '.*HAPLOTYPECALLER_PARABRICKS:HTSLIB_BGZIPTABIX' {
        ext.prefix = { meta.interval_name ? "${meta.id}.${meta.interval_name}" : meta.id }
    }
    withName: PARABRICKS_HAPLOTYPECALLER {
        ext.prefix = { (meta.num_intervals ?: 1) <= 1 ? "${meta.id}" : "${meta.id}_${meta.interval_name}" }
        ext.args = {
            def args = []
            def use_low_memory = params.enable_low_gpu_memory_mode.toBoolean() || ((task.attempt ?: 1) > 1)
            def gpu_count = task.accelerator ? task.accelerator.request : 1
            // Partitioned runs (--run-partition) reserve CPU capacity across
            // internal work partitions, so divide total CPUs by a factor of 5
            // to avoid oversubscribing the host. In low-memory mode, halve
            // threads further to reduce memory pressure.
            def partition_cpu_divisor = (gpu_count > 1) ? 5 : 1
            def num_threads = Math.max(1, ((task.cpus / partition_cpu_divisor) / (use_low_memory ? 2 : 1)) as int)
            def gpu_args = use_low_memory
                ? '--htvc-low-memory'
                : ''
            if (task.accelerator) { args << "--num-gpus ${task.accelerator.request}" }
            args << gpu_args
            def run_partition = (gpu_count > 1) ? "--run-partition" : ""
            args << run_partition
            args << "--num-htvc-threads ${num_threads}"
            // --activeregion-alt-multiplier is omitted when the param is null
            // (e.g. simplex data, where the multiplier should not be used).
            def alt_multiplier = params.gatk_activeregion_alt_multiplier != null
                ? "--activeregion-alt-multiplier ${params.gatk_activeregion_alt_multiplier} "
                : ''
            args << "--min-base-quality-score 6 --haplotypecaller-options \"-A TandemRepeat -A AssemblyComplexity --adaptive-pruning ${alt_multiplier}--mapping-quality-threshold-for-genotyping 1 --minimum-mapping-quality 1 --enable-dynamic-read-disqualification-for-genotyping --filter-reads-too-long\""
            return args.join(' \\\n')
        }
    }
    withName: BCFTOOLS_REHEADER_GERMLINE_SAMPLE {
        ext.prefix = { "${meta.id}_reheadered" }
        ext.args2 = { "--output-type z --write-index=tbi" }
    }
    withName: BCFTOOLS_REHEADER_GERMLINE_RETRAINED_SAMPLE {
        ext.prefix = { "${meta.id}_retrained_reheadered" }
        ext.args2 = { "--output-type z --write-index=tbi" }
    }
    withName: BCFTOOLS_REHEADER_CNC_GERMLINE {
        ext.prefix = { "${meta.id}_cnc_reheadered" }
        ext.args2 = { "--output-type z --write-index=tbi" }
    }
    withName: '.*CALL_GERMLINE_VARIANTS:BCFTOOLS_CONCAT' {
        ext.args = "--output-type z --write-index=tbi --allow-overlaps"
    }
    withName: '.*CALL_GERMLINE_VARIANTS:BCFTOOLS_INDEX' {
        ext.args = "--tbi"
    }
    withName: XOOS_STR_CALLER {
        // The str_caller --aligner option accepts {unknown, bwa, giraffe}; when omitted it defaults to
        // 'unknown' and infers the aligner from the BAM @PG header.
        ext.args = { (params.aligner == 'pb_giraffe' || params.aligner == 'vg_giraffe') ? '--aligner giraffe' : '' }
    }
    withName: '.*RETRAIN_GERMLINE_SMALL_VARIANT_MODEL:XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_GERMLINE_WGS' {
        // Add a suffix to the output VCF file to distinguish it from pre-trained results
        ext.prefix = { "${meta.id}_retrained" }
    }
    withName: XOOS_SMALL_VARIANT_CALLER_COMPUTE_BAM_FEATURES {
        ext.args = { "--sequencing-protocol ${params.small_variant_caller_sequencing_protocol}" }
    }
    withName: XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_GERMLINE_WGS {
        ext.args = { "--sequencing-protocol ${params.small_variant_caller_sequencing_protocol} --model-type ${params.small_variant_caller_germline_model_type}" }
    }
    withName: XOOS_SMALL_VARIANT_CALLER_TRAIN_MODEL {
        ext.args = { '--model-type small' }
    }
}
