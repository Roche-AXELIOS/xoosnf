profiles {
    enable_pb_dynamic_scaling {
        process {
            withName: PARABRICKS_FQ2BAM_SINGLE_END_MULTIPLE_FASTQS {
                memory = {
                    // Optional upper bound: cap at task.ext.dynamic_scaling_max_mem if set.
                    def max_mem = task.ext?.dynamic_scaling_max_mem

                    if (task.ext?.spotRetry && task.previousTrace?.memory) {
                        def prev = task.previousTrace.memory
                        return max_mem && prev > max_mem ? max_mem : prev
                    }
                    def fastq_paths = []
                    if (reads) {
                        if (reads instanceof List) {
                            fastq_paths = reads
                        } else if (reads != null) {
                            fastq_paths = [reads]
                        }
                    }
                    def total_size = 0L
                    fastq_paths.each { path ->
                        def realpath = path.toRealPath()
                        if (realpath.exists() && realpath.isDirectory()) {
                            try {
                                java.nio.file.Files
                                    .walk(realpath)
                                    .filter { p -> p.getFileName().toString().endsWith(".fastq.gz") }
                                    .forEach { p ->
                                        try {
                                            total_size += java.nio.file.Files.size(p)
                                        } catch (Exception _ignored) {
                                            // Ignore unreadable files
                                        }
                                    }
                            }
                            catch (Exception _ignored) {
                                // Ignore directory access issues
                            }
                        }
                        else if (realpath.exists()) {
                            try {
                                total_size += java.nio.file.Files.size(realpath)
                            } catch (Exception _ignored) {
                                // Ignore unreadable files
                            }
                        }
                    }
                    // Baseline required host memory.
                    def base_gb = 128.GB
                    // Memory scaling model (FASTQ size):
                    //   For each additional 10 GiB of input FASTQs, add 2 GB of host memory.
                    // These values are tuned to avoid runaway requests for very large sharded inputs.
                    def bytes_per_bucket = 10.GB.toBytes() // 10 GiB of FASTQs
                    def per_bucket_gb = 2.GB
                    def effective_bytes = Math.max(0L, total_size)
                    def extra_buckets = (bytes_per_bucket > 0L)
                        ? Math.floor(effective_bytes / bytes_per_bucket) as int
                        : 0

                    // CPU scaling model:
                    //   Add additional host memory per CPU requested.
                    // Rationale: PB/Giraffe shows higher resident set size with more threads.
                    def cpu_count = (task.cpus ?: 1) as int
                    def per_cpu_gb = 1.GB
                    def cpu_mem_gb = per_cpu_gb * cpu_count

                    // Retry scaling model:
                    //   Increase memory for retries to mitigate OOM from data-dependent variance.
                    // Multiplier is applied to the computed request.
                    def retry_multiplier = 1.5
                    def attempt = (task.attempt ?: 1) as int
                    def attempt_multiplier = Math.pow(retry_multiplier, Math.max(0, attempt - 1))

                    // We compute the final requested memory by starting with the base_gb, adding extra memory based on FASTQs total size and adding CPU-based memory based on the number of CPUs requested. We then apply the retry multiplier to the total if this is a retry attempt.
                    def requested = base_gb + (per_bucket_gb * extra_buckets) + cpu_mem_gb
                    def requested_with_retry = requested * attempt_multiplier

                    return max_mem && requested_with_retry > max_mem ? max_mem : requested_with_retry
                }
            }

            withName: PARABRICKS_GIRAFFE_SINGLE_END_MULTIPLE_FASTQS {
                memory = {
                    // Optional upper bound: cap at task.ext.dynamic_scaling_max_mem if set.
                    def max_mem = task.ext?.dynamic_scaling_max_mem

                    if (task.ext?.spotRetry && task.previousTrace?.memory) {
                        def prev = task.previousTrace.memory
                        return max_mem && prev > max_mem ? max_mem : prev
                    }
                    def fastq_paths = []
                    if (reads) {
                        if (reads instanceof List) {
                            fastq_paths = reads
                        }
                        else if (reads != null) {
                            fastq_paths = [reads]
                        }
                    }
                    def total_size = 0L
                    fastq_paths.each { path ->
                        def realpath = path.toRealPath()
                        if (realpath.exists() && realpath.isDirectory()) {
                            try {
                                java.nio.file.Files
                                    .walk(realpath)
                                    .filter { p -> p.getFileName().toString().endsWith(".fastq.gz") }
                                    .forEach { p ->
                                        try {
                                            total_size += java.nio.file.Files.size(p)
                                        } catch (Exception _ignored) {
                                            // Ignore unreadable files
                                        }
                                    }
                            }
                            catch (Exception _ignored) {
                                // Ignore directory access issues
                            }
                        }
                        else if (realpath.exists()) {
                            try {
                                total_size += java.nio.file.Files.size(realpath)
                            } catch (Exception _ignored) {
                                // Ignore unreadable files
                            }
                        }
                    }
                    // Baseline required host memory.
                    def base_gb = 128.GB
                    // Memory scaling model (FASTQ size):
                    //   For each additional 10 GiB of input FASTQs, add 2 GB of host memory.
                    // These values are tuned to avoid runaway requests for very large sharded inputs.
                    def bytes_per_bucket = 10.GB.toBytes() // 10 GiB of FASTQs
                    def per_bucket_gb = 2.GB
                    def effective_bytes = Math.max(0L, total_size)
                    def extra_buckets = (bytes_per_bucket > 0L)
                        ? Math.floor(effective_bytes / bytes_per_bucket) as int
                        : 0

                    // CPU scaling model:
                    //   Add additional host memory per CPU requested.
                    // Rationale: PB/Giraffe shows higher resident set size with more threads.
                    def cpu_count = (task.cpus ?: 1) as int
                    def per_cpu_gb = 1.GB
                    def cpu_mem_gb = per_cpu_gb * cpu_count

                    // GPU scaling model:
                    //   Add additional GPU memory based on the number of GPUs requested.
                    // Rationale: With fewer GPUs, each GPU processes more data which can increase memory usage. With more GPUs, the workload is distributed and memory usage per GPU can decrease.
                    def gpu_count = (task.accelerator.request ?: 1) as int
                    def per_gpu_gb = 4.GB
                    def gpu_mem_gb = Math.max(0, 32 - (per_gpu_gb.toGiga() * gpu_count)).GB

                    // Retry scaling model:
                    //   Increase memory for retries to mitigate OOM from data-dependent variance.
                    // Multiplier is applied to the computed request.
                    def retry_multiplier = 1.5
                    def attempt = (task.attempt ?: 1) as int
                    def attempt_multiplier = Math.pow(retry_multiplier, Math.max(0, attempt - 1))

                    // We compute the final requested memory by starting with the base_gb, adding extra memory based on FASTQs total size and adding CPU-based memory based on the number of CPUs requested and extra mem based on the number of GPUs. We then apply the retry multiplier to the total if this is a retry attempt.
                    def requested = base_gb + (per_bucket_gb * extra_buckets) + cpu_mem_gb + gpu_mem_gb
                    def requested_with_retry = requested * attempt_multiplier

                    return max_mem && requested_with_retry > max_mem ? max_mem : requested_with_retry
                }
            }

            withName: PARABRICKS_HAPLOTYPECALLER {
                memory = {
                    // Optional upper bound: cap at task.ext.dynamic_scaling_max_mem if set.
                    def max_mem = task.ext?.dynamic_scaling_max_mem

                    if (task.ext?.spotRetry && task.previousTrace?.memory) {
                        def prev = task.previousTrace.memory
                        return max_mem && prev > max_mem ? max_mem : prev
                    }
                    def total_size = 0L
                    if (input) {
                        def bam_path = input.toRealPath()
                        if (bam_path != null && bam_path.exists()) {
                            try {
                                total_size = java.nio.file.Files.size(bam_path)
                            } catch (Exception _ignored) {
                                // Ignore unreadable files
                            }
                        }
                    }

                    // Baseline required host memory.
                    def base_gb = 24.GB

                    // Scale: add 2GB per 50GiB of BAM.
                    def bytes_per_bucket = 50L * 1024L * 1024L * 1024L
                    def per_bucket_gb = 2.GB
                    def effective_bytes = Math.max(0L, total_size)
                    def extra_buckets = (bytes_per_bucket > 0L)
                        ? Math.floor(effective_bytes / bytes_per_bucket) as int
                        : 0

                    // CPU scaling model:
                    //   Add additional host memory per CPU requested.
                    // Rationale: HaplotypeCaller memory usage increases with thread count.
                    def cpu_count = (task.cpus ?: 1) as int
                    def per_cpu_gb = 1.GB
                    def cpu_mem_gb = per_cpu_gb * cpu_count

                    // Retry scaling model:
                    //   Increase memory for retries to mitigate OOM from data-dependent variance.
                    def retry_multiplier = 1.5
                    def attempt = (task.attempt ?: 1) as int
                    def attempt_multiplier = Math.pow(retry_multiplier, Math.max(0, attempt - 1))

                    // We compute the final requested memory by starting with the base_gb, adding extra memory based on BAM size and adding CPU-based memory based on the number of CPUs requested. We then apply the retry multiplier to the total if this is a retry attempt.
                    def requested = base_gb + (per_bucket_gb * extra_buckets) + cpu_mem_gb
                    def requested_with_retry = requested * attempt_multiplier

                    return max_mem && requested_with_retry > max_mem ? max_mem : requested_with_retry
                }
            }

            withName: PARABRICKS_MUTECTCALLER {
                memory = {
                    // Optional upper bound: cap at task.ext.dynamic_scaling_max_mem if set.
                    def max_mem = task.ext?.dynamic_scaling_max_mem

                    if (task.ext?.spotRetry && task.previousTrace?.memory) {
                        def prev = task.previousTrace.memory
                        return max_mem && prev > max_mem ? max_mem : prev
                    }
                    def total_size = 0L
                    def bam_paths = []
                    if (tumor_bam) {
                        bam_paths << tumor_bam
                    }
                    if (normal_bam) {
                        bam_paths << normal_bam
                    }
                    bam_paths.each { path ->
                        def realpath = path.toRealPath()
                        if (realpath != null && realpath.exists() && !realpath.isDirectory()) {
                            try {
                                total_size += java.nio.file.Files.size(realpath)
                            } catch (Exception _ignored) {
                                // Ignore unreadable files
                            }
                        }
                    }

                    // Baseline required host memory.
                    def base_gb = 24.GB

                    // Scale: add 2GB per 50GiB of BAM.
                    def bytes_per_bucket = 50L * 1024L * 1024L * 1024L
                    def per_bucket_gb = 2.GB
                    def effective_bytes = Math.max(0L, total_size)
                    def extra_buckets = (bytes_per_bucket > 0L)
                        ? Math.floor(effective_bytes / bytes_per_bucket) as int
                        : 0

                    // CPU scaling model:
                    //   Add additional host memory per CPU requested.
                    // Rationale: Mutect2 memory usage increases with thread count.
                    def cpu_count = (task.cpus ?: 1) as int
                    def per_cpu_gb = 2.GB
                    def cpu_mem_gb = per_cpu_gb * cpu_count

                    // Retry scaling model:
                    //   Increase memory for retries to mitigate OOM from data-dependent variance.
                    def retry_multiplier = 1.5
                    def attempt = (task.attempt ?: 1) as int
                    def attempt_multiplier = Math.pow(retry_multiplier, Math.max(0, attempt - 1))

                    // We compute the final requested memory by starting with the base_gb, adding extra memory based on BAM size and adding CPU-based memory based on the number of CPUs requested. We then apply the retry multiplier to the total if this is a retry attempt.
                    def requested = base_gb + (per_bucket_gb * extra_buckets) + cpu_mem_gb
                    def requested_with_retry = requested * attempt_multiplier

                    return max_mem && requested_with_retry > max_mem ? max_mem : requested_with_retry
                }
            }
        }
    }
}
