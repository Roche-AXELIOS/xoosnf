profiles {
    germline_wgs_duplex {
        params.variant_calling_mode                         = 'germline'
        params.aligner                                      = 'pb_giraffe'
        params.enable_pangenome_personalization             = true
        params.exclude_partial_reads                        = true
        params.enable_demux_strand_detect                   = false
        params.dedup_strategy                               = 'markdup'
        params.read_collapser_preset                        = 'wgs-duplex'
        params.read_collapser_cluster_by_umi                = false
        params.enable_subsample_bam                         = false
        params.subsample_bam_coverage_target                = null
        params.enable_contamination_estimation              = true
        params.enable_alignment_metrics_autosomes           = true
        params.enable_alignment_metrics_targets             = false
        params.enable_alignment_metrics_high_confidence     = true
        params.enable_hp_metrics                            = false
        params.enable_gc_bias_metrics                       = false
        params.enable_hs_metrics                            = false
        params.enable_pre_dedup_metrics                     = false
        params.enable_pre_subsample_metrics                 = false
        params.alignment_metrics_min_base_quality_pre_dedup = 30
        params.alignment_metrics_min_base_quality           = 30
        params.enable_small_variant_caller                  = true
        params.enable_small_variant_caller_retrain          = false
        params.enable_copy_number_caller                    = true
        params.enable_str_caller                            = true
        params.enable_merge_vcf                             = true
        params.enable_variant_calling_partitioning          = true
        params.cpu_variant_calling_partition_count          = 20
        params.gpu_variant_calling_partition_count          = 1
    }

    germline_wgs_duplex_benchmark {
        params.variant_calling_mode                         = 'germline'
        params.aligner                                      = 'pb_giraffe'
        params.enable_pangenome_personalization             = true
        params.exclude_partial_reads                        = true
        params.enable_demux_strand_detect                   = false
        params.dedup_strategy                               = 'markdup'
        params.read_collapser_preset                        = 'wgs-duplex'
        params.read_collapser_cluster_by_umi                = false
        params.enable_subsample_bam                         = true
        params.subsample_bam_coverage_target                = 30
        params.enable_contamination_estimation              = true
        params.enable_alignment_metrics_autosomes           = true
        params.enable_alignment_metrics_targets             = false
        params.enable_alignment_metrics_high_confidence     = true
        params.enable_hp_metrics                            = true
        params.enable_gc_bias_metrics                       = true
        params.enable_hs_metrics                            = false
        params.enable_pre_dedup_metrics                     = false
        params.enable_pre_subsample_metrics                 = false
        params.alignment_metrics_min_base_quality_pre_dedup = 30
        params.alignment_metrics_min_base_quality           = 30
        params.alignment_metrics_additional_regions         = [
            "homopolymers",
            "msi_sensor_homopolymers",
            "segmental_duplications",
            "tandem_repeats",
            "variable_number_tandem_repeats"
        ]
        params.enable_small_variant_caller                  = true
        params.enable_small_variant_caller_retrain          = true
        params.enable_copy_number_caller                    = true
        params.enable_str_caller                            = true
        params.enable_merge_vcf                             = true
        params.enable_vcfeval                               = true
        params.enable_variant_calling_partitioning          = true
        params.cpu_variant_calling_partition_count          = 20
        params.gpu_variant_calling_partition_count          = 1
    }
}
