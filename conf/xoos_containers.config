process {
    withName: 'XOOS_ALIGNMENT_METRICS_ALL|XOOS_ALIGNMENT_METRICS_COVERAGE' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/alignment_metrics:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_COPY_NUMBER_CALLER_GERMLINE_WGS|XOOS_COPY_NUMBER_CALLER_TUMOR_NORMAL_WGS' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/copy_number_caller:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_DEMUX' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/demux:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_GENERATE_REPORT|XOOS_GENERATE_REPORT_SUMMARY|XOOS_PARSE_ALIGNMENT_METRICS|XOOS_PARSE_CONTAMINATION_METRICS|XOOS_PARSE_CNC_METRICS_GERMLINE|XOOS_PARSE_CNC_METRICS_SOMATIC|XOOS_PARSE_DEMUX_METRICS|XOOS_PARSE_GC_BIAS_METRICS|XOOS_PARSE_HS_METRICS|XOOS_PARSE_READ_COLLAPSER_METRICS|XOOS_PARSE_RESCUE_SECONDARY_METRICS|XOOS_PARSE_STR_METRICS|XOOS_PARSE_VCF_EVAL_METRICS' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/nf/generate-metrics-report:${params.xoos_version ?: 'latest'}"
    }
    withName: 'KMC_KMER_COUNT' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/nf/kmc:${params.xoos_version ?: 'latest'}"
    }
    withName: 'SUBSAMPLE_RUN' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/nf/subsample-run:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_TUMOR_FRACTION_ESTIMATOR_TUMOR_FRACTION|XOOS_TUMOR_FRACTION_ESTIMATOR_CONTAMINATION_DETECTION' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/tumor_fraction_estimator:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_READ_COLLAPSER_CONSENSUS|XOOS_READ_COLLAPSER_MARK_DUPLICATES|XOOS_READ_COLLAPSER_RESCUE_SECONDARY' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/read_collapser:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_SMALL_VARIANT_CALLER_COMPUTE_BAM_FEATURES|XOOS_SMALL_VARIANT_CALLER_COMPUTE_VCF_FEATURES|XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_GERMLINE_WGS|XOOS_SMALL_VARIANT_CALLER_FILTER_VARIANTS_TUMOR_NORMAL_WGS|XOOS_SMALL_VARIANT_CALLER_TRAIN_MODEL' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/small_variant_caller:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_STR_CALLER' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/str_caller:${params.xoos_version ?: 'latest'}"
    }
    withName: 'XOOS_ALIGNMENT_METRICS_TO_MULTIQC|XOOS_CNC_METRICS_TO_MULTIQC_GERMLINE|XOOS_CNC_METRICS_TO_MULTIQC_SOMATIC|XOOS_COMBINE_MULTIQC_REPORTS|XOOS_CONTAMINATION_METRICS_TO_MULTIQC|XOOS_DEMUX_METRICS_TO_MULTIQC|XOOS_READ_COLLAPSER_METRICS_TO_MULTIQC|XOOS_STR_METRICS_TO_MULTIQC|XOOS_TFE_METRICS_TO_MULTIQC|XOOS_VCFEVAL_METRICS_TO_MULTIQC' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/nf/xoos-to-multiqc:${params.xoos_version ?: 'latest'}"
    }
    withName: 'ADD_RUN_INFO_TO_MULTIQC_HEADER' {
        container = "${params.xoos_registry ?: 'navifyplatform-eug-docker.jfrog.io'}/xoos/nf/add-run-info-to-multiqc-header:${params.xoos_version ?: 'latest'}"
    }
}
