includeConfig '../subworkflows/local/demultiplex/nextflow.config'
includeConfig '../subworkflows/local/align/nextflow.config'
includeConfig '../subworkflows/local/subsample_bam/nextflow.config'
includeConfig '../subworkflows/local/dedup/nextflow.config'
includeConfig '../subworkflows/local/metrics/nextflow.config'
includeConfig '../subworkflows/local/call_germline_variants/nextflow.config'
includeConfig '../subworkflows/local/evaluate_small_variant_calls/nextflow.config'
includeConfig '../subworkflows/local/call_somatic_variants_tn/nextflow.config'
includeConfig '../subworkflows/local/subsample_basecall_runs/nextflow.config'
includeConfig '../subworkflows/local/tumor_fraction_estimation/nextflow.config'

process {
    // Reheader BAM-start inputs (enable_bam_reheader) so every @RG line's ID
    // and SM tags are set to the samplesheet sample_name (meta.id). The header
    // is piped to sed via `samtools reheader -c`; literal tab bytes (Groovy \t)
    // delimit the fields so the basic-regex sed program works regardless of the
    // sed flavour in the container. A distinct prefix avoids the module's
    // input==output name guard.
    withName: 'SAMTOOLS_REHEADER' {
        ext.prefix = { "${meta.id}_reheadered" }
        ext.args = { "-c 'sed \"/^@RG/{s/\tID:[^\t]*/\tID:${meta.id}/;s/\tSM:[^\t]*/\tSM:${meta.id}/}\"'" }
    }
}
