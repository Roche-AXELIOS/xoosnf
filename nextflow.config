/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Roche-AXELIOS/xoosnf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // XOOS container options
    xoos_registry                                    = null
    xoos_version                                     = null

    // Input options
    input                                            = null
    enable_bam_reheader                              = false

    // Subsampling options
    enable_subsample_run                             = false
    subsample_run_ratio                              = 1.0
    subsample_run_absolute_size                      = 0
    subsample_run_copy_mode                          = 'copy'
    subsample_run_strategy                           = 'random-ratio'
    enable_subsample_demuxed_fastq                   = false
    subsample_demuxed_fastq_read_count               = 200000000
    enable_subsample_bam                             = false
    subsample_bam_coverage_target                    = null
    subsample_bam_metric_name                        = 'post_filter_coverage'
    enable_publish_pre_subsample_bam                 = false

    // Demultiplex options
    exclude_partial_reads                            = true
    enable_demux_early_stop                          = false
    demux_early_stop_coverage_target                 = 30
    enable_demux_strand_detect                       = false
    enable_publish_demuxed_fastqs                    = false

    // Alignment options
    aligner                                          = 'pb_giraffe'
    enable_low_gpu_memory_mode                       = false
    enable_pangenome_personalization                 = false
    pangenome_personalization_downsample_read_count  = 200000000
    max_parabricks_alignment_read_length             = null

    // FASTQ partitioning options
    enable_alignment_partitioning                    = false
    alignment_partition_count                        = 4

    // Deduplication options
    dedup_strategy                                   = 'markdup'
    enable_read_collapser_dedup                                  = false
    read_collapser_preset                            = null
    read_collapser_cluster_by_umi                    = false
    read_collapser_ignore_read_name_parsing_errors   = false
    rescue_secondary_min_alignment_score_ratio       = null

    // Tumor fraction estimator options
    enable_tfe                                       = false
    tfe_included_regions_bed                         = null

    // Contamination detection resources
    enable_contamination_estimation                  = false
    contamination_vcf                                = null
    contamination_included_regions_bed               = null

    // Variant calling options
    variant_calling_mode                             = 'none'
    enable_small_variant_caller                      = false
    use_multisample_model                            = true
    use_gatk_haplotype_caller                        = false
    use_gatk_mutect2                                 = false
    enable_variant_calling_partitioning              = false
    gpu_variant_calling_partition_count              = 1
    cpu_variant_calling_partition_count              = 20
    enable_small_variant_caller_retrain              = false
    enable_vcfeval                                   = false
    enable_mutect_stats                              = false
    enable_str_caller                                = false
    enable_copy_number_caller                        = false
    enable_copy_number_caller_baf                    = true
    enable_merge_vcf                                 = false

    // Workflow configuration (provenance only, not parsed by pipeline)
    workflow_config                                  = null

    // Resource files
    resources_base                                   = "."
    reference_fasta                                  = null
    reference_fai                                    = null
    reference_dict                                   = null
    bwa_index_dir                                    = null
    giraffe_index_dir                                = null
    giraffe_reference_linearized                     = null
    unfiltered_giraffe_index_dir                     = null
    unfiltered_giraffe_reference_linearized          = null
    mappability_bw                                   = null
    cnv_seed_seg                                     = null
    cnv_blocklist_bed                                = null
    repeat_catalog                                   = null
    pop_af_vcf                                       = null
    pop_af_tbi                                       = null
    high_confidence_bed_dir                          = null
    fallback_high_confidence_bed                     = null
    autosomes_bed                                    = null
    chr_x_par_bed                                    = null
    chr_y_par_bed                                    = null
    target_bed                                       = null
    capture_bed                                      = null
    demux_strand_detect_index                        = null
    svc_model_germline_snv                           = null
    svc_model_germline_indel                         = null
    svc_model_somatic_tumor_normal                   = null
    svc_model_somatic_tumor_only                     = null
    germline_small_variant_truth_vcf_dir             = null
    germline_small_variant_train_bed_dir             = null
    germline_small_variant_test_bed_dir              = null
    germline_small_variant_eval_bed_dir              = null
    somatic_tumor_normal_small_variant_truth_vcf_dir = null
    somatic_tumor_normal_small_variant_eval_bed_dir  = null
    reference_sdf                                    = null

    // Metrics options
    enable_alignment_metrics_autosomes               = false
    enable_alignment_metrics_targets                 = false
    enable_alignment_metrics_high_confidence         = false
    enable_hp_metrics                                = false
    enable_gc_bias_metrics                           = false
    enable_hs_metrics                                = false
    enable_pre_dedup_metrics                         = false
    enable_pre_subsample_metrics                     = false
    alignment_metrics_min_mapping_quality            = 4
    alignment_metrics_min_base_quality               = 30
    alignment_metrics_min_base_quality_pre_dedup     = 30
    alignment_metrics_max_alt_allele_fraction        = 0.1
    alignment_metrics_min_depth                      = 10
    alignment_metrics_coverage_bins                  = ""
    metrics_report_summary_patterns                  = [
        '^alignment_metrics/dedup(_subsample)?_autosomes/accuracy/all_errors_with_indel_bases/phred$',
        '^alignment_metrics/dedup_autosomes/read_metrics/duplicate_reads%$',
        '^alignment_metrics/dedup(_subsample)?_autosomes/read_metrics/mean/post_filter_read_length_excluding_soft_clipped_bases$',
        '^alignment_metrics/dedup(_subsample)?_autosomes/coverage/median/(any_coverage|concordant_duplex_coverage)$',
        '^alignment_metrics/dedup(_subsample)?_autosomes/read_metrics/soft_clipped_bases%$',
        '^alignment_metrics/dedup(_subsample)?_high_confidence/accuracy/all_errors_with_indel_bases/phred$',
        '^alignment_metrics/dedup(_subsample)?_high_confidence/accuracy/hp_errors/any/(8|10)/phred$',
        '^alignment_metrics/dedup(_subsample)?_high_confidence/coverage/median/(any_coverage|concordant_duplex_coverage)$',
        '^alignment_metrics/dedup(_subsample)?_high_confidence/coverage/ratio_median_to_10_percentile/(any_coverage|concordant_duplex_coverage)$',
        '^read_collapser/duplicate_reads%$',
        '^demux/(total_reads|passing_reads%|full_duplex_reads|full_duplex_reads%|partial_duplex_reads|partial_duplex_reads%|unassigned_reads%|assigned_reads|concordant_bases|concordant_bases%)$',
        '^gc_bias/dedup(_subsample)?/bins_20-70_normalized_coverage_0.8-1.2%$',
        '^gc_bias/dedup(_subsample)?/gc_nc_0_19$',
        '^gc_bias/dedup(_subsample)?/gc_nc_80_100$',
        '^vcf_eval/(small_variant_pretrained|small_variant_retrained)/non_snp/f_measure$',
        '^vcf_eval/(small_variant_pretrained|small_variant_retrained)/snp/f_measure$',
        '^contamination_detection/(Tumor_Fraction|Mean_VAF|Error_Rate|Variants|Variants_Detected|Noise_Tumor_Fraction)$',
        '^str_caller/(NumSites|LowDepth|LowConfidence)$',
        '^copy_number_caller/(number_of_targets|sex|number_of_segments|number_of_gain_segments|number_of_loss_segments|number_of_passing_gain_segments|number_of_passing_loss_segments|median_coverage|percentage_of_low_coverage_windows)$',
    ]

    // MultiQC options
    multiqc_config                                   = null
    multiqc_title                                    = null
    multiqc_logo                                     = null
    max_multiqc_email_size                           = '25.MB'
    multiqc_methods_description                      = null

    // Executor options
    executor_queue_size                              = 1000

    // Boilerplate options
    outdir                                           = "output"
    publish_dir_mode                                 = 'copy'
    email                                            = null
    email_on_fail                                    = null
    plaintext_email                                  = false
    monochrome_logs                                  = false
    help                                             = false
    help_full                                        = false
    show_hidden                                      = false
    version                                          = false
    pipelines_testdata_base_path                     = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    modules_testdata_base_path                       = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    trace_report_suffix                              = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name                              = null
    config_profile_description                       = null

    custom_config_version                            = 'master'
    custom_config_base                               = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact                           = null
    config_profile_url                               = null

    // Schema validation default options
    validate_params                                  = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load workflow profile configs
includeConfig 'conf/germline.config'
includeConfig 'conf/simplex.config'
includeConfig 'conf/somatic.config'
includeConfig 'conf/cfdna.config'
includeConfig 'conf/pb_dynamic_scaling.config'

profiles {
    debug {
        dumpHashes                                   = true
        process.beforeScript                         = 'echo $HOSTNAME'
        cleanup                                      = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled       = true
        conda.enabled        = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }
    docker_rootless {
        docker.enabled       = true
        conda.enabled        = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'container'
    }
    emulate_amd64 {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    podman {
        podman.enabled       = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }
    shifter {
        shifter.enabled      = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }
    charliecloud {
        charliecloud.enabled = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        apptainer.enabled    = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'container'
    }
    gpu {
        docker.runOptions      = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions   = '--nv'
        singularity.runOptions = '--nv'
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test_full.config'
    }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load Roche-AXELIOS/xoosnf custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load Roche-AXELIOS/xoosnf custom profiles from different institutions.
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/xoos.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry = 'quay.io'
docker.registry = 'quay.io'
podman.registry = 'quay.io'
singularity.registry = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Executor settings
executor {
    queueSize = params.executor_queue_size
}

// Set bash options
process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail",
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'Roche-AXELIOS/xoosnf'
    contributors    = [
        [
            name: 'Alister D’Costa',
            affiliation: 'Roche',
            email: '231282388+dcostaa1-roche@users.noreply.github.com',
            github: '@dcostaa1-roche',
            contribution: ['maintainer'],
            orcid: 'https://orcid.org/0009-0000-5868-0481'
        ],
        [
            name: 'Austin Doupnik',
            affiliation: 'Roche',
            email: '42255109+doupnika-roche@users.noreply.github.com',
            github: '@doupnika-roche',
            contribution: ['author', 'maintainer'],
            orcid: 'https://orcid.org/0009-0008-6234-9917'
        ],
        [
            name: 'Junxuan Gao',
            affiliation: 'Roche',
            email: '172086117+gaoj66-roche@users.noreply.github.com',
            github: '@gaoj66-roche',
            contribution: ['author', 'maintainer'],
            orcid: 'https://orcid.org/0009-0007-0595-3053'
        ],
        [
            name: 'Pavan Kumar Kotha',
            contribution: ['maintainer'],
            affiliation: 'Roche'
        ]
    ]
    homePage        = 'https://github.com/Roche-AXELIOS/xoosnf'
    description     = "XOOS (sbX Optimized Open Source) Nextflow pipeline for processing sequencing data produced by the Roche AXELIOS 1 sequencer"
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.1.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2'
}

validation {
    monochromeLogs                        = params.monochrome_logs
    logging.unrecognisedParams            = 'error'
}

outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
includeConfig 'workflows/nextflow.config'

// Only override module-level pinned containers when an operator explicitly
// opts in by setting xoos_version or xoos_registry. Otherwise the pinned
// containers declared in each module are used.
includeConfig params.xoos_version || params.xoos_registry ? 'conf/xoos_containers.config' : '/dev/null'
